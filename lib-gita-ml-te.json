.io (English)","url":"https://vedabase.io/en/library/bg/1/3/"}]}},{"id":"gita-ml-te-ch1-v4","topic":"1.4 · పాండవ విలుకాండ్రు","note":"భీమార్జునులకు సాటి వీరుల పేర్లు చెబుతాడు: యుయుధానుడు, విరాటుడు, ద్రుపదుడు.","hyperLink":"https://vedabase.io/en/library/bg/1/4/","manas":{"links":[{"label":"📖 BG 1.4 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/4/"}]}},{"id":"gita-ml-te-ch1-v5","topic":"1.5 · మరిన్ని వీరులు","note":"పాండవుల వైపు ధృష్టకేతువు, చేకితానుడు, కాశీరాజు, పురుజిత్తు, కుంతిభోజుడు, శైబ్యుడు కూడా ఉన్నారు.","hyperLink":"https://vedabase.io/en/library/bg/1/5/","manas":{"links":[{"label":"📖 BG 1.5 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/5/"}]}},{"id":"gita-ml-te-ch1-v6","topic":"1.6 · మహారథులు","note":"యుధామన్యువు, ఉత్తమౌజుడు, సుభద్ర కుమారుడు, ద్రౌపది కుమారులు — అందరూ మహారథులు.","hyperLink":"https://vedabase.io/en/library/bg/1/6/","manas":{"links":[{"label":"📖 BG 1.6 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/6/"}]}},{"id":"gita-ml-te-ch1-v7","topic":"1.7 · తన సేనానాయకులు","note":"ఇప్పుడు దుర్యోధనుడు తన సైన్యంలోని ముఖ్య నాయకుల గురించి ద్రోణునికి చెబుతాడు.","hyperLink":"https://vedabase.io/en/library/bg/1/7/","manas":{"links":[{"label":"📖 BG 1.7 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/7/"}]}},{"id":"gita-ml-te-ch1-v8","topic":"1.8 · కౌరవ వీరులు","note":"ద్రోణుడు, భీష్ముడు, కర్ణుడు, కృపుడు, అశ్వత్థామ, వికర్ణుడు, భూరిశ్రవుడు — ఎప్పుడూ గెలిచేవారు.","hyperLink":"https://vedabase.io/en/library/bg/1/8/","manas":{"links":[{"label":"📖 BG 1.8 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/8/"}]}},{"id":"gita-ml-te-ch1-v9","topic":"1.9 · ప్రాణాలివ్వడానికి సిద్ధం","note":"ఇంకా ఎందరో యోధులు ఆయుధాలతో, యుద్ధ నైపుణ్యంతో, అతని కోసం ప్రాణాలివ్వడానికి సిద్ధంగా ఉన్నారు.","hyperLink":"https://vedabase.io/en/library/bg/1/9/","manas":{"links":[{"label":"📖 BG 1.9 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/9/"}]}},{"id":"gita-ml-te-ch1-v10","topic":"1.10 · బలాల పోలిక","note":"భీష్ముడు కాపాడే తన సైన్యం భీముడు కాపాడే పాండవ సైన్యం కంటే బలమైనదని అతను భావిస్తాడు.","hyperLink":"https://vedabase.io/en/library/bg/1/10/","manas":{"links":[{"label":"📖 BG 1.10 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/10/"}]}},{"id":"gita-ml-te-ch1-v11","topic":"1.11 · భీష్మునికి అండగా నిలవండి","note":"అందరూ తమ తమ స్థానాల్లో స్థిరంగా నిలిచి భీష్ముని రక్షించమని అతను కోరుతాడు.","hyperLink":"https://vedabase.io/en/library/bg/1/11/","manas":{"links":[{"label":"📖 BG 1.11 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/11/"}]}}]},{"id":"gita-ml-te-ch1-s2","topic":"1.12–19 · శంఖనాదం","note":"1.12–19 · శంఖనాదం · BG 1.12–20","hyperLink":"https://vedabase.io/en/library/bg/1/","manas":{"links":[{"label":"📖 BG 1 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/"}]},"children":[{"id":"gita-ml-te-ch1-v12","topic":"1.12 · భీష్ముని శంఖం","note":"దుర్యోధనుని సంతోషపరచడానికి భీష్ముడు సింహగర్జన వంటి శంఖనాదం చేస్తాడు.","hyperLink":"https://vedabase.io/en/library/bg/1/12/","manas":{"links":[{"label":"📖 BG 1.12 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/12/"}]}},{"id":"gita-ml-te-ch1-v13","topic":"1.13 · గొప్ప కోలాహలం","note":"తర్వాత శంఖాలు, భేరులు, డోళ్లు, కొమ్ములు ఒక్కసారిగా మోగి పెద్ద శబ్దం పుడుతుంది.","hyperLink":"https://vedabase.io/en/library/bg/1/13/","manas":{"links":[{"label":"📖 BG 1.13 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/13/"}]}},{"id":"gita-ml-te-ch1-v14","topic":"1.14 · కృష్ణార్జునుల శంఖాలు","note":"మరోవైపు తెల్లని గుర్రాల రథంలో ఉన్న కృష్ణుడు, అర్జునుడు తమ శంఖాలను ఊదుతారు.","hyperLink":"https://vedabase.io/en/library/bg/1/14/","manas":{"links":[{"label":"📖 BG 1.14 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/14/"}]}},{"id":"gita-ml-te-ch1-v15","topic":"1.15 · పాంచజన్యం, దేవదత్తం, పౌండ్రం","note":"కృష్ణుడు పాంచజన్యం, అర్జునుడు దేవదత్తం, భీముడు పౌండ్రం అనే శంఖాలను ఊదుతారు.","hyperLink":"https://vedabase.io/en/library/bg/1/15/","manas":{"links":[{"label":"📖 BG 1.15 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/15/"}],"q":"కృష్ణుడు, అర్జునుడు, భీముడు ఊదిన శంఖాల పేర్లు ఏమిటి?"}},{"id":"gita-ml-te-ch1-v16-18","topic":"1.16-18 · ఇతర పాండవుల శంఖాలు","note":"యుధిష్ఠిరుడు, నకులుడు, సహదేవుడు, పాండవుల ఇతర మిత్రులు కూడా తమ శంఖాలను ఊదుతారు.","hyperLink":"https://vedabase.io/en/library/bg/1/16-18/","manas":{"links":[{"label":"📖 BG 1.16-18 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/16-18/"}]}},{"id":"gita-ml-te-ch1-v19","topic":"1.19 · భూమ్యాకాశాలు మారుమోగాయి","note":"ఆ నాదం భూమ్యాకాశాల్లో ప్రతిధ్వనించి ధృతరాష్ట్రుని కుమారుల గుండెలను వణికిస్తుంది.","hyperLink":"https://vedabase.io/en/library/bg/1/19/","manas":{"links":[{"label":"📖 BG 1.19 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/19/"}]}},{"id":"gita-ml-te-ch1-v20","topic":"1.20 · హనుమంతుని ధ్వజం","note":"హనుమంతుని గుర్తు ఉన్న జెండా కింద అర్జునుడు విల్లు ఎత్తి కృష్ణునితో మాట్లాడుతాడు.","hyperLink":"https://vedabase.io/en/library/bg/1/20/","manas":{"links":[{"label":"📖 BG 1.20 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/20/"}]}}]},{"id":"gita-ml-te-ch1-s3","topic":"1.20–27 · అర్జునుడు రెండు సైన్యాలను చూస్తాడు","note":"1.20–27 · అర్జునుడు రెండు సైన్యాలను చూస్తాడు · BG 1.21–29","hyperLink":"https://vedabase.io/en/library/bg/1/","manas":{"links":[{"label":"📖 BG 1 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/"}]},"children":[{"id":"gita-ml-te-ch1-v21-22","topic":"1.21-22 · రథాన్ని మధ్యలో నిలుపు","note":"ఎవరితో పోరాడాలో చూడటానికి రథాన్ని రెండు సైన్యాల మధ్య నిలపమని అర్జునుడు కృష్ణుని కోరుతాడు.","hyperLink":"https://vedabase.io/en/library/bg/1/21-22/","manas":{"links":[{"label":"📖 BG 1.21-22 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/21-22/"}],"q":"రథాన్ని ఎక్కడ నిలపమని అర్జునుడు కృష్ణుని కోరాడు?"}},{"id":"gita-ml-te-ch1-v23","topic":"1.23 · ఎవరు పోరాడ వచ్చారు","note":"దుర్యోధనుని మెప్పించడానికి ఎవరెవరు వచ్చారో చూడాలని అతను కోరుకుంటాడు.","hyperLink":"https://vedabase.io/en/library/bg/1/23/","manas":{"links":[{"label":"📖 BG 1.23 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/23/"}]}},{"id":"gita-ml-te-ch1-v24","topic":"1.24 · రథం మధ్యలో","note":"కృష్ణుడు రథాన్ని రెండు సైన్యాల మధ్యకు తీసుకెళ్లి నిలుపుతాడు.","hyperLink":"https://vedabase.io/en/library/bg/1/24/","manas":{"links":[{"label":"📖 BG 1.24 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/24/"}]}},{"id":"gita-ml-te-ch1-v25","topic":"1.25 · కురువులను చూడు","note":"భీష్మ ద్రోణుల ఎదుట కృష్ణుడు అంటాడు: పార్థా, ఇక్కడ చేరిన కురువులందరినీ చూడు.","hyperLink":"https://vedabase.io/en/library/bg/1/25/","manas":{"links":[{"label":"📖 BG 1.25 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/25/"}]}},{"id":"gita-ml-te-ch1-v26","topic":"1.26 · రెండు వైపులా తనవారే","note":"రెండు సైన్యాల్లోనూ తండ్రులు, తాతలు, గురువులు, మేనమామలు, సోదరులు, కుమారులు, మిత్రులు, మామలను అర్జునుడు చూస్తాడు.","hyperLink":"https://vedabase.io/en/library/bg/1/26/","manas":{"links":[{"label":"📖 BG 1.26 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/26/"}],"q":"రెండు సైన్యాల్లో అర్జునుడు ఎవరిని చూశాడు?"}},{"id":"gita-ml-te-ch1-v27","topic":"1.27 · కరుణతో నిండాడు","note":"తన బంధువులనే చూసి అర్జునుడు కరుణతో నిండిపోతాడు.","hyperLink":"https://vedabase.io/en/library/bg/1/27/","manas":{"links":[{"label":"📖 BG 1.27 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/27/"}]}},{"id":"gita-ml-te-ch1-v28","topic":"1.28 · అవయవాలు వణుకుతున్నాయి","note":"అర్జునుడు అంటాడు: నా వారిని యుద్ధానికి సిద్ధంగా చూసి నా అవయవాలు వణుకుతున్నాయి, నోరు ఎండిపోతోంది.","hyperLink":"https://vedabase.io/en/library/bg/1/28/","manas":{"links":[{"label":"📖 BG 1.28 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/28/"}]}},{"id":"gita-ml-te-ch1-v29","topic":"1.29 · గాండీవం జారుతోంది","note":"శరీరం వణుకుతోంది, రోమాలు నిక్కబొడుచుకున్నాయి, గాండీవం చేతి నుండి జారుతోంది, చర్మం మండుతోంది.","hyperLink":"https://vedabase.io/en/library/bg/1/29/","manas":{"links":[{"label":"📖 BG 1.29 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/29/"}]}}]},{"id":"gita-ml-te-ch1-s4","topic":"1.28–46 · అర్జునుని దుఃఖం","note":"1.28–46 · అర్జునుని దుఃఖం · BG 1.30–46","hyperLink":"https://vedabase.io/en/library/bg/1/","manas":{"links":[{"label":"📖 BG 1 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/"}]},"children":[{"id":"gita-ml-te-ch1-v30","topic":"1.30 · మనసు తిరుగుతోంది","note":"అతను నిలబడలేకపోతున్నాడు, మనసు తిరుగుతోంది, అపశకునాలే కనిపిస్తున్నాయి.","hyperLink":"https://vedabase.io/en/library/bg/1/30/","manas":{"links":[{"label":"📖 BG 1.30 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/30/"}]}},{"id":"gita-ml-te-ch1-v31","topic":"1.31 · విజయం వద్దు","note":"తన బంధువులను చంపడంలో అతనికి ఏ మేలూ కనిపించదు; విజయం గానీ రాజ్యం గానీ అతనికి వద్దు.","hyperLink":"https://vedabase.io/en/library/bg/1/31/","manas":{"links":[{"label":"📖 BG 1.31 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/31/"}],"q":"యుద్ధంలో అర్జునునికి మేలు ఎందుకు కనిపించలేదు?"}},{"id":"gita-ml-te-ch1-v32-35","topic":"1.32-35 · రాజ్యం దేనికి","note":"ఎవరి కోసం రాజ్యం, సుఖం కావాలో వారే ఇక్కడ చావడానికి నిలబడ్డారు; ముల్లోకాల కోసమైనా అతను వారిని చంపడు.","hyperLink":"https://vedabase.io/en/library/bg/1/32-35/","manas":{"links":[{"label":"📖 BG 1.32-35 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/32-35/"}]}},{"id":"gita-ml-te-ch1-v36","topic":"1.36 · పాపం అంటుతుంది","note":"వీరిని చంపితే పాపం అంటుతుంది; మనవారిని చంపి మనం ఎలా సుఖపడతాం?","hyperLink":"https://vedabase.io/en/library/bg/1/36/","manas":{"links":[{"label":"📖 BG 1.36 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/36/"}]}},{"id":"gita-ml-te-ch1-v37-38","topic":"1.37-38 · లోభంతో గుడ్డివారు","note":"వారు లోభంతో గుడ్డివారయ్యారు, కానీ కులనాశనంలోని దోషం మనకు తెలుసు — మరి మనం ఎందుకు ఇలా చేయాలి?","hyperLink":"https://vedabase.io/en/library/bg/1/37-38/","manas":{"links":[{"label":"📖 BG 1.37-38 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/37-38/"}]}},{"id":"gita-ml-te-ch1-v39","topic":"1.39 · కులధర్మ నాశనం","note":"కులం నశిస్తే దాని శాశ్వత సంప్రదాయాలు అంతరించి అధర్మం వ్యాపిస్తుంది.","hyperLink":"https://vedabase.io/en/library/bg/1/39/","manas":{"links":[{"label":"📖 BG 1.39 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/39/"}]}},{"id":"gita-ml-te-ch1-v40","topic":"1.40 · అధర్మ ఫలం","note":"అధర్మం పెరిగితే కుటుంబ నడవడి చెడి, అవాంఛిత సంతానం పుడుతుంది.","hyperLink":"https://vedabase.io/en/library/bg/1/40/","manas":{"links":[{"label":"📖 BG 1.40 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/40/"}]}},{"id":"gita-ml-te-ch1-v41","topic":"1.41 · పితరుల పతనం","note":"దీనివల్ల కుటుంబానికీ, దానిని నాశనం చేసినవారికీ నరకప్రాయ జీవితం; పితరులకు తర్పణం అందదు.","hyperLink":"https://vedabase.io/en/library/bg/1/41/","manas":{"links":[{"label":"📖 BG 1.41 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/41/"}]}},{"id":"gita-ml-te-ch1-v42","topic":"1.42 · సంక్షేమ కార్యాల నాశనం","note":"కులనాశకుల దుష్కర్మల వల్ల సమాజ, కుటుంబ సంక్షేమ కార్యాలన్నీ నశిస్తాయి.","hyperLink":"https://vedabase.io/en/library/bg/1/42/","manas":{"links":[{"label":"📖 BG 1.42 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/42/"}]}},{"id":"gita-ml-te-ch1-v43","topic":"1.43 · పరంపర ద్వారా విన్నది","note":"అలాంటివారు నరకంలో ఉంటారని అర్జునుడు గురుపరంపర ద్వారా విన్నాడు.","hyperLink":"https://vedabase.io/en/library/bg/1/43/","manas":{"links":[{"label":"📖 BG 1.43 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/43/"}]}},{"id":"gita-ml-te-ch1-v44","topic":"1.44 · ఎంత విచిత్రం","note":"రాజసుఖం కోసం మన బంధువులనే చంపడానికి సిద్ధపడ్డాం, ఎంత విచిత్రం!","hyperLink":"https://vedabase.io/en/library/bg/1/44/","manas":{"links":[{"label":"📖 BG 1.44 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/44/"}]}},{"id":"gita-ml-te-ch1-v45","topic":"1.45 · నన్నే చంపనివ్వండి","note":"ఆయుధం లేకుండా ఎదురించని నన్ను ధృతరాష్ట్రుని కుమారులు చంపినా అదే మేలు.","hyperLink":"https://vedabase.io/en/library/bg/1/45/","manas":{"links":[{"label":"📖 BG 1.45 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/45/"}]}},{"id":"gita-ml-te-ch1-v46","topic":"1.46 · విల్లు కింద పెట్టాడు","note":"సంజయుడు చెబుతాడు: అర్జునుడు విల్లంబులను విడిచి, దుఃఖంతో నిండిన మనసుతో రథంలో కూర్చుంటాడు.","hyperLink":"https://vedabase.io/en/library/bg/1/46/","manas":{"links":[{"label":"📖 BG 1.46 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/46/"}],"q":"అధ్యాయం చివర అర్జునుడు ఏమి చేశాడు?"}}]},{"id":"gita-ml-te-ch1-see","topic":"🔗 vedabase.io · తెలుగు","note":"Bhagavad-gita Chapter 1 on vedabase.io (English). The same chapter in the other nine languages is on this library's shelf.","hyperLink":"https://vedabase.io/en/library/bg/1/","manas":{"links":[{"label":"📖 BG 1 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/"}]}}]}},"part":"te","updated":1795357904858,"created":1795357904858},{"id":"gita-ml-te-ch2","title":"తెలుగు · అధ్యాయం 2 · ఆత్మ, కర్తవ్యం, స్థిరమైన బుద్ధి","look":"paper","layout":"side","library":"gita-ml","data":{"direction":2,"nodeData":{"id":"gita-ml-te-ch2-root","topic":"అధ్యాయం 2 · ఆత్మ, కర్తవ్యం, స్థిరమైన బుద్ధి","note":"భగవద్గీత అధ్యాయం 2 లోని ప్రతి శ్లోకానికి మా స్వంత ఒక్క వాక్య సారాంశం, తెలుగులో. ప్రతి బుడగ vedabase.io లోని ఆ శ్లోకానికి లింక్ చేయబడింది (అక్కడ తెలుగు సంపుటి లేదు, కాబట్టి ఆంగ్ల పేజీ). ముసాయిదా: అనువాదం సమీక్షించబడలేదు — తెలుగు మాతృభాషా సమీక్షకుడు కావాలి. · Draft · translation unreviewed · a native Telugu reviewer is wanted. Our own one-line summaries, not the BBT translation. Search words: గీత, భగవద్గీత, అర్జునుడు, కృష్ణుడు, కురుక్షేత్రం, శ్లోకం, Bhagavad-gita, Gita, Telugu, తెలుగు, అధ్యాయం 2, ఆత్మ, సాంఖ్యం, కర్మయోగం, బుద్ధియోగం, స్థితప్రజ్ఞుడు, soul, duty, steady mind.","hyperLink":"https://vedabase.io/en/library/bg/2/","children":[{"id":"gita-ml-te-ch2-s1","topic":"2.1–10 · అర్జునుడు శిష్యుడవుతాడు","note":"2.1–10 · అర్జునుడు శిష్యుడవుతాడు · BG 2.1–10","hyperLink":"https://vedabase.io/en/library/bg/2/","manas":{"links":[{"label":"📖 BG 2 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/"}]},"children":[{"id":"gita-ml-te-ch2-v1","topic":"2.1 · ఏడుస్తున్న అర్జునునితో కృష్ణుడు","note":"సంజయుడు చెబుతాడు: కరుణ, కన్నీళ్లతో ఉన్న అర్జునుని చూసి కృష్ణుడు మాట్లాడటం మొదలుపెడతాడు.","hyperLink":"https://vedabase.io/en/library/bg/2/1/","manas":{"links":[{"label":"📖 BG 2.1 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/1/"}]}},{"id":"gita-ml-te-ch2-v2","topic":"2.2 · ఈ బలహీనత తగదు","note":"కృష్ణుడు: ఈ బలహీనత ఉత్తమునికి తగదు; ఇది స్వర్గం కాదు, అపకీర్తి తెస్తుంది.","hyperLink":"https://vedabase.io/en/library/bg/2/2/","manas":{"links":[{"label":"📖 BG 2.2 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/2/"}]}},{"id":"gita-ml-te-ch2-v3","topic":"2.3 · లే, పిరికితనం వదులు","note":"హృదయంలోని ఈ చిన్న బలహీనతను వదిలి యుద్ధానికి లే.","hyperLink":"https://vedabase.io/en/library/bg/2/3/","manas":{"links":[{"label":"📖 BG 2.3 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/3/"}]}},{"id":"gita-ml-te-ch2-v4","topic":"2.4 · పూజ్యులపై బాణాలు ఎలా?","note":"అర్జునుడు: నేను గౌరవించాల్సిన భీష్ముడు, ద్రోణునిపై బాణాలు ఎలా వేయగలను?","hyperLink":"https://vedabase.io/en/library/bg/2/4/","manas":{"links":[{"label":"📖 BG 2.4 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/4/"}]}},{"id":"gita-ml-te-ch2-v5","topic":"2.5 · భిక్ష మేలు","note":"గురువుల రక్తంతో తడిసిన భోగాల కంటే భిక్షమెత్తి బతకడం మేలు.","hyperLink":"https://vedabase.io/en/library/bg/2/5/","manas":{"links":[{"label":"📖 BG 2.5 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/5/"}]}},{"id":"gita-ml-te-ch2-v6","topic":"2.6 · గెలవాలా ఓడాలా?","note":"గెలవడం మంచిదో ఓడడం మంచిదో అర్జునునికి తెలియదు; ధృతరాష్ట్రుని కుమారులను చంపి బతకాలని లేదు.","hyperLink":"https://vedabase.io/en/library/bg/2/6/","manas":{"links":[{"label":"📖 BG 2.6 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/6/"}]}},{"id":"gita-ml-te-ch2-v7","topic":"2.7 · నేను నీ శిష్యుడను","note":"కర్తవ్యం గురించి అయోమయంలో ఉన్న అర్జునుడు కృష్ణుని శరణు పొంది శిష్యుడై స్పష్టమైన ఉపదేశం అడుగుతాడు.","hyperLink":"https://vedabase.io/en/library/bg/2/7/","manas":{"links":[{"label":"📖 BG 2.7 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/7/"}],"q":"అర్జునుడు కృష్ణుని ఏ భావంతో ఉపదేశం అడిగాడు?"}},{"id":"gita-ml-te-ch2-v8","topic":"2.8 · ఏ రాజ్యమూ దుఃఖం తీర్చదు","note":"దేవతల వంటి రాజ్యం దొరికినా అతని ఈ దుఃఖం పోదు.","hyperLink":"https://vedabase.io/en/library/bg/2/8/","manas":{"links":[{"label":"📖 BG 2.8 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/8/"}]}},{"id":"gita-ml-te-ch2-v9","topic":"2.9 · నేను యుద్ధం చేయను","note":"'గోవిందా, నేను యుద్ధం చేయను' అని అర్జునుడు మౌనం వహిస్తాడు.","hyperLink":"https://vedabase.io/en/library/bg/2/9/","manas":{"links":[{"label":"📖 BG 2.9 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/9/"}]}},{"id":"gita-ml-te-ch2-v10","topic":"2.10 · కృష్ణుడు నవ్వుతాడు","note":"రెండు సైన్యాల మధ్య కృష్ణుడు చిరునవ్వుతో దుఃఖిస్తున్న అర్జునునితో మాట్లాడతాడు.","hyperLink":"https://vedabase.io/en/library/bg/2/10/","manas":{"links":[{"label":"📖 BG 2.10 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/10/"}]}}]},{"id":"gita-ml-te-ch2-s2","topic":"2.11–30 · ఆత్మ ఎన్నడూ చావదు","note":"2.11–30 · ఆత్మ ఎన్నడూ చావదు · BG 2.11–30","hyperLink":"https://vedabase.io/en/library/bg/2/","manas":{"links":[{"label":"📖 BG 2 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/"}]},"children":[{"id":"gita-ml-te-ch2-v11","topic":"2.11 · జ్ఞానులు దుఃఖించరు","note":"పండితునిలా మాట్లాడుతూనే వృథాగా దుఃఖిస్తున్నావు; జ్ఞానులు బతికున్నవారి కోసమూ చనిపోయినవారి కోసమూ దుఃఖించరు.","hyperLink":"https://vedabase.io/en/library/bg/2/11/","manas":{"links":[{"label":"📖 BG 2.11 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/11/"}]}},{"id":"gita-ml-te-ch2-v12","topic":"2.12 · మనం ఎప్పుడూ ఉన్నాం","note":"కృష్ణుడు, అర్జునుడు, ఈ రాజులు లేని కాలం ఎన్నడూ లేదు, ఇకపై కూడా ఉండదు.","hyperLink":"https://vedabase.io/en/library/bg/2/12/","manas":{"links":[{"label":"📖 BG 2.12 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/12/"}]}},{"id":"gita-ml-te-ch2-v13","topic":"2.13 · శరీరం మారుతుంది, ఆత్మ సాగుతుంది","note":"ఆత్మ బాల్యం, యౌవనం, వృద్ధాప్యం దాటినట్లే మరణంలో మరో శరీరానికి వెళ్తుంది.","hyperLink":"https://vedabase.io/en/library/bg/2/13/","manas":{"links":[{"label":"📖 BG 2.13 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/13/"}],"q":"మరణ సమయంలో ఆత్మకు ఏమవుతుంది?"}},{"id":"gita-ml-te-ch2-v14","topic":"2.14 · ఋతువుల్లా సహించు","note":"సుఖదుఃఖాలు చలి, ఎండ లాగా వచ్చిపోతాయి; వాటిని ఓర్పుతో భరించడం నేర్చుకో.","hyperLink":"https://vedabase.io/en/library/bg/2/14/","manas":{"links":[{"label":"📖 BG 2.14 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/14/"}]}},{"id":"gita-ml-te-ch2-v15","topic":"2.15 · సమభావంతో మోక్షం","note":"సుఖదుఃఖాల్లో చలించనివాడే మోక్షానికి అర్హుడు.","hyperLink":"https://vedabase.io/en/library/bg/2/15/","manas":{"links":[{"label":"📖 BG 2.15 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/15/"}]}},{"id":"gita-ml-te-ch2-v16","topic":"2.16 · సత్ మరియు అసత్","note":"తత్త్వదర్శుల నిర్ణయం: శరీరం నిలవదు, ఆత్మ మారదు.","hyperLink":"https://vedabase.io/en/library/bg/2/16/","manas":{"links":[{"label":"📖 BG 2.16 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/16/"}]}},{"id":"gita-ml-te-ch2-v17","topic":"2.17 · శరీరమంతా వ్యాపించినది","note":"శరీరమంతా చైతన్యాన్ని వ్యాపింపజేసే ఆత్మను ఎవరూ నాశనం చేయలేరు.","hyperLink":"https://vedabase.io/en/library/bg/2/17/","manas":{"links":[{"label":"📖 BG 2.17 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/17/"}]}},{"id":"gita-ml-te-ch2-v18","topic":"2.18 · కాబట్టి యుద్ధం చేయి","note":"నిత్యమైన ఆత్మ యొక్క శరీరం తప్పక నశిస్తుంది; కాబట్టి యుద్ధం చేయి.","hyperLink":"https://vedabase.io/en/library/bg/2/18/","manas":{"links":[{"label":"📖 BG 2.18 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/18/"}]}},{"id":"gita-ml-te-ch2-v19","topic":"2.19 · చంపదు, చావదు","note":"ఆత్మను చంపేదిగా లేదా చచ్చేదిగా భావించే ఇద్దరూ ఎరుగరు; ఆత్మ చంపదు, చావదు.","hyperLink":"https://vedabase.io/en/library/bg/2/19/","manas":{"links":[{"label":"📖 BG 2.19 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/19/"}]}},{"id":"gita-ml-te-ch2-v20","topic":"2.20 · పుట్టుక లేదు, చావు లేదు","note":"ఆత్మ పుట్టనిది, నిత్యమైనది, సనాతనమైనది; శరీరం చనిపోయినా అది చావదు.","hyperLink":"https://vedabase.io/en/library/bg/2/20/","manas":{"links":[{"label":"📖 BG 2.20 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/20/"}],"q":"శరీరం చనిపోతే ఆత్మ చనిపోతుందా?"}},{"id":"gita-ml-te-ch2-v21","topic":"2.21 · ఎవరు ఎవరిని చంపుతారు?","note":"ఆత్మ నాశనం లేనిది, పుట్టనిది అని తెలిసినవాడు ఎవరినైనా ఎలా చంపుతాడు లేదా చంపిస్తాడు?","hyperLink":"https://vedabase.io/en/library/bg/2/21/","manas":{"links":[{"label":"📖 BG 2.21 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/21/"}]}},{"id":"gita-ml-te-ch2-v22","topic":"2.22 · పాత బట్టలు, కొత్త బట్టలు","note":"మనిషి పాత బట్టలు విడిచి కొత్తవి ధరించినట్లు ఆత్మ కొత్త శరీరాలు పొందుతుంది.","hyperLink":"https://vedabase.io/en/library/bg/2/22/","manas":{"links":[{"label":"📖 BG 2.22 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/22/"}],"q":"ఆత్మ శరీరం మార్చడాన్ని దేనితో పోల్చారు?"}},{"id":"gita-ml-te-ch2-v23","topic":"2.23 · ఆయుధాలు నరకలేవు","note":"ఆయుధాలు ఆత్మను నరకలేవు, అగ్ని కాల్చలేదు, నీరు తడపలేదు, గాలి ఎండబెట్టలేదు.","hyperLink":"https://vedabase.io/en/library/bg/2/23/","manas":{"links":[{"label":"📖 BG 2.23 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/23/"}]}},{"id":"gita-ml-te-ch2-v24","topic":"2.24 · విరగనిది, మారనిది","note":"ఆత్మ విరగనిది, నిత్యమైనది, అంతటా ఉన్నది, కదలనిది, ఎల్లప్పుడూ ఒకేలా ఉంటుంది.","hyperLink":"https://vedabase.io/en/library/bg/2/24/","manas":{"links":[{"label":"📖 BG 2.24 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/24/"}]}},{"id":"gita-ml-te-ch2-v25","topic":"2.25 · ఇంద్రియాలకు అతీతం","note":"ఆత్మ కనిపించనిది, ఊహకందనిది; ఇది తెలిసి శరీరం కోసం దుఃఖించకు.","hyperLink":"https://vedabase.io/en/library/bg/2/25/","manas":{"links":[{"label":"📖 BG 2.25 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/25/"}]}},{"id":"gita-ml-te-ch2-v26","topic":"2.26 · అయినా దుఃఖానికి కారణం లేదు","note":"ఆత్మ మళ్లీ మళ్లీ పుట్టి చనిపోతుందని అనుకున్నా దుఃఖించడానికి కారణం లేదు.","hyperLink":"https://vedabase.io/en/library/bg/2/26/","manas":{"links":[{"label":"📖 BG 2.26 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/26/"}]}},{"id":"gita-ml-te-ch2-v27","topic":"2.27 · పుట్టినవానికి చావు తప్పదు","note":"పుట్టినవానికి మరణం, మరణించినవానికి జన్మ తప్పవు; కాబట్టి కర్తవ్యంలో దుఃఖించకు.","hyperLink":"https://vedabase.io/en/library/bg/2/27/","manas":{"links":[{"label":"📖 BG 2.27 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/27/"}]}},{"id":"gita-ml-te-ch2-v28","topic":"2.28 · అవ్యక్తం-వ్యక్తం-అవ్యక్తం","note":"జీవులు మొదట కనిపించవు, మధ్యలో కనిపిస్తాయి, చివర మళ్లీ కనిపించవు; ఇక దుఃఖం ఎందుకు?","hyperLink":"https://vedabase.io/en/library/bg/2/28/","manas":{"links":[{"label":"📖 BG 2.28 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/28/"}]}},{"id":"gita-ml-te-ch2-v29","topic":"2.29 · ఆశ్చర్యకరమైన ఆత్మ","note":"కొందరు ఆత్మను ఆశ్చర్యంగా చూస్తారు, కొందరు వర్ణిస్తారు, కొందరు వింటారు; చాలామంది విన్నా అర్థం చేసుకోరు.","hyperLink":"https://vedabase.io/en/library/bg/2/29/","manas":{"links":[{"label":"📖 BG 2.29 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/29/"}]}},{"id":"gita-ml-te-ch2-v30","topic":"2.30 · దేహి అవధ్యుడు","note":"శరీరంలో నివసించేవాడిని ఎన్నడూ చంపలేరు; కాబట్టి ఏ ప్రాణి కోసమూ దుఃఖించకు.","hyperLink":"https://vedabase.io/en/library/bg/2/30/","manas":{"links":[{"label":"📖 BG 2.30 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/30/"}]}}]},{"id":"gita-ml-te-ch2-s3","topic":"2.31–38 · క్షత్రియుని కర్తవ్యం","note":"2.31–38 · క్షత్రియుని కర్తవ్యం · BG 2.31–38","hyperLink":"https://vedabase.io/en/library/bg/2/","manas":{"links":[{"label":"📖 BG 2 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/"}]},"children":[{"id":"gita-ml-te-ch2-v31","topic":"2.31 · క్షత్రియ ధర్మం","note":"క్షత్రియునికి ధర్మం కోసం పోరాడటం కంటే మించిన కర్తవ్యం లేదు; కాబట్టి సంకోచించకు.","hyperLink":"https://vedabase.io/en/library/bg/2/31/","manas":{"links":[{"label":"📖 BG 2.31 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/31/"}]}},{"id":"gita-ml-te-ch2-v32","topic":"2.32 · స్వర్గానికి తెరిచిన ద్వారం","note":"అదృష్టవంతులైన క్షత్రియులకు ఇలాంటి యుద్ధం అడగకుండానే దొరుకుతుంది, అది స్వర్గ ద్వారం తెరుస్తుంది.","hyperLink":"https://vedabase.io/en/library/bg/2/32/","manas":{"links":[{"label":"📖 BG 2.32 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/32/"}]}},{"id":"gita-ml-te-ch2-v33","topic":"2.33 · పాపం, అపకీర్తి","note":"ఈ ధర్మయుద్ధం చేయకపోతే కర్తవ్యం విడిచిన పాపం, కీర్తి నష్టం కలుగుతాయి.","hyperLink":"https://vedabase.io/en/library/bg/2/33/","manas":{"links":[{"label":"📖 BG 2.33 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/33/"}]}},{"id":"gita-ml-te-ch2-v34","topic":"2.34 · అవమానం మరణం కంటే చెడ్డది","note":"ప్రజలు ఎప్పటికీ నిన్ను నిందిస్తారు; గౌరవనీయునికి అవమానం మరణం కంటే చెడ్డది.","hyperLink":"https://vedabase.io/en/library/bg/2/34/","manas":{"links":[{"label":"📖 BG 2.34 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/34/"}]}},{"id":"gita-ml-te-ch2-v35","topic":"2.35 · పిరికివాడిగా భావిస్తారు","note":"మహారథులు నువ్వు భయంతో పారిపోయావని భావించి నిన్ను చులకనగా చూస్తారు.","hyperLink":"https://vedabase.io/en/library/bg/2/35/","manas":{"links":[{"label":"📖 BG 2.35 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/35/"}]}},{"id":"gita-ml-te-ch2-v36","topic":"2.36 · శత్రువుల ఎగతాళి","note":"శత్రువులు కటువైన మాటలతో నీ సామర్థ్యాన్ని ఎగతాళి చేస్తారు; ఇంతకంటే బాధ ఏముంది?","hyperLink":"https://vedabase.io/en/library/bg/2/36/","manas":{"links":[{"label":"📖 BG 2.36 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/36/"}]}},{"id":"gita-ml-te-ch2-v37","topic":"2.37 · రెండు విధాలా లాభం","note":"చనిపోతే స్వర్గం, గెలిస్తే భూరాజ్యం; కాబట్టి దృఢనిశ్చయంతో లేచి పోరాడు.","hyperLink":"https://vedabase.io/en/library/bg/2/37/","manas":{"links":[{"label":"📖 BG 2.37 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/37/"}]}},{"id":"gita-ml-te-ch2-v38","topic":"2.38 · సమభావంతో పోరాడు","note":"సుఖదుఃఖాలు, లాభనష్టాలు, జయాపజయాలు సమానంగా భావించి పోరాడు; అప్పుడు పాపం అంటదు.","hyperLink":"https://vedabase.io/en/library/bg/2/38/","manas":{"links":[{"label":"📖 BG 2.38 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/38/"}]}}]},{"id":"gita-ml-te-ch2-s4","topic":"2.39–53 · ఫలాసక్తి లేని కర్మ (బుద్ధియోగం)","note":"2.39–53 · ఫలాసక్తి లేని కర్మ (బుద్ధియోగం) · BG 2.39–53","hyperLink":"https://vedabase.io/en/library/bg/2/","manas":{"links":[{"label":"📖 BG 2 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/"}]},"children":[{"id":"gita-ml-te-ch2-v39","topic":"2.39 · ఇప్పుడు బుద్ధియోగం విను","note":"ఇంతవరకు సాంఖ్యంతో వివరించాను; ఇప్పుడు ఫలాపేక్ష లేని కర్మయోగం విను, అది కర్మబంధం నుండి విడిపిస్తుంది.","hyperLink":"https://vedabase.io/en/library/bg/2/39/","manas":{"links":[{"label":"📖 BG 2.39 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/39/"}]}},{"id":"gita-ml-te-ch2-v40","topic":"2.40 · ఈ మార్గంలో నష్టం లేదు","note":"ఇక్కడ ఏ ప్రయత్నమూ వృథా కాదు; కొద్ది పురోగతి కూడా గొప్ప భయం నుండి కాపాడుతుంది.","hyperLink":"https://vedabase.io/en/library/bg/2/40/","manas":{"links":[{"label":"📖 BG 2.40 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/40/"}]}},{"id":"gita-ml-te-ch2-v41","topic":"2.41 · ఒకే లక్ష్యం","note":"దృఢచిత్తులకు లక్ష్యం ఒక్కటే; అస్థిరుని బుద్ధి అనేక శాఖలుగా చీలుతుంది.","hyperLink":"https://vedabase.io/en/library/bg/2/41/","manas":{"links":[{"label":"📖 BG 2.41 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/41/"}]}},{"id":"gita-ml-te-ch2-v42-43","topic":"2.42-43 · ఆకర్షణీయమైన మాటలు","note":"అల్పజ్ఞులు స్వర్గం, మంచి జన్మ, అధికారం ఇస్తాయని చెప్పే వేదాల ఆకర్షణీయ మాటల్లో చిక్కుకుని, ఇంతకు మించి ఏమీ లేదంటారు.","hyperLink":"https://vedabase.io/en/library/bg/2/42-43/","manas":{"links":[{"label":"📖 BG 2.42-43 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/42-43/"}]}},{"id":"gita-ml-te-ch2-v44","topic":"2.44 · భోగాసక్తిలో దృఢత్వం లేదు","note":"భోగాలు, సంపదలో చిక్కుకున్నవారి మనసులో భగవంతుని భక్తికి దృఢనిశ్చయం కలగదు.","hyperLink":"https://vedabase.io/en/library/bg/2/44/","manas":{"links":[{"label":"📖 BG 2.44 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/44/"}]}},{"id":"gita-ml-te-ch2-v45","topic":"2.45 · త్రిగుణాలకు అతీతంగా ఎదుగు","note":"వేదాలు ప్రధానంగా మూడు గుణాల గురించి చెబుతాయి; వాటిని దాటి, ద్వంద్వాలు, చింతలు వదిలి ఆత్మలో స్థిరపడు.","hyperLink":"https://vedabase.io/en/library/bg/2/45/","manas":{"links":[{"label":"📖 BG 2.45 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/45/"}]}},{"id":"gita-ml-te-ch2-v46","topic":"2.46 · బావి, సరస్సు","note":"చిన్న బావి చేసే పని పెద్ద జలాశయంతో జరుగుతుంది; వేదాల ఉద్దేశం తెలిసినవానికి అన్నీ లభిస్తాయి.","hyperLink":"https://vedabase.io/en/library/bg/2/46/","manas":{"links":[{"label":"📖 BG 2.46 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/46/"}]}},{"id":"gita-ml-te-ch2-v47","topic":"2.47 · కర్మ నీది, ఫలం కాదు","note":"కర్మ చేయడంలోనే నీకు అధికారం, ఫలంలో కాదు; నిన్ను ఫలానికి కారణంగా భావించకు, కర్మ మానడంలోనూ ఆసక్తి వద్దు.","hyperLink":"https://vedabase.io/en/library/bg/2/47/","manas":{"links":[{"label":"📖 BG 2.47 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/47/"}],"q":"కర్మ మరియు ఫలం గురించి కృష్ణుడు ఏమంటాడు?"}},{"id":"gita-ml-te-ch2-v48","topic":"2.48 · సమత్వమే యోగం","note":"జయాపజయాలపై ఆసక్తి వదిలి సమభావంతో కర్మ చేయి; ఆ సమత్వమే యోగం.","hyperLink":"https://vedabase.io/en/library/bg/2/48/","manas":{"links":[{"label":"📖 BG 2.48 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/48/"}]}},{"id":"gita-ml-te-ch2-v49","topic":"2.49 · ఫలం కోసమే పని లోభం","note":"భక్తితో నీచ కర్మలను దూరంగా ఉంచి భగవంతుని శరణు పొందు; ఫలం మాత్రమే కోరేవారు లోభులు.","hyperLink":"https://vedabase.io/en/library/bg/2/49/","manas":{"links":[{"label":"📖 BG 2.49 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/49/"}]}},{"id":"gita-ml-te-ch2-v50","topic":"2.50 · యోగం: కర్మలో నైపుణ్యం","note":"భక్తిలో నిమగ్నుడు ఈ జన్మలోనే మంచి చెడు ఫలాల నుండి విముక్తుడవుతాడు; యోగం కర్మ యొక్క కళ.","hyperLink":"https://vedabase.io/en/library/bg/2/50/","manas":{"links":[{"label":"📖 BG 2.50 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/50/"}]}},{"id":"gita-ml-te-ch2-v51","topic":"2.51 · జనన మరణాలకు అతీతం","note":"ఇలా పనిచేసే ఋషులు కర్మఫలం నుండి విడివడి జనన మరణ చక్రం నుండి విముక్తులై దుఃఖం లేని స్థితి చేరతారు.","hyperLink":"https://vedabase.io/en/library/bg/2/51/","manas":{"links":[{"label":"📖 BG 2.51 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/51/"}]}},{"id":"gita-ml-te-ch2-v52","topic":"2.52 · మోహపు అడవి నుండి బయటకు","note":"బుద్ధి మోహమనే దట్టమైన అడవిని దాటినప్పుడు విన్నవి, వినబోయేవి నీకు పట్టవు.","hyperLink":"https://vedabase.io/en/library/bg/2/52/","manas":{"links":[{"label":"📖 BG 2.52 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/52/"}]}},{"id":"gita-ml-te-ch2-v53","topic":"2.53 · సమాధిలో స్థిరం","note":"మనసు వేదాల ఆకర్షణీయ మాటలకు చలించక ఆత్మసాక్షాత్కారంలో నిలిచినప్పుడు నువ్వు యోగం పొందుతావు.","hyperLink":"https://vedabase.io/en/library/bg/2/53/","manas":{"links":[{"label":"📖 BG 2.53 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/53/"}]}}]},{"id":"gita-ml-te-ch2-s5","topic":"2.54–72 · స్థిరబుద్ధి గలవాడు","note":"2.54–72 · స్థిరబుద్ధి గలవాడు · BG 2.54–72","hyperLink":"https://vedabase.io/en/library/bg/2/","manas":{"links":[{"label":"📖 BG 2 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/"}]},"children":[{"id":"gita-ml-te-ch2-v54","topic":"2.54 · అర్జునుని ప్రశ్న","note":"అర్జునుడు అడుగుతాడు: స్థిరబుద్ధి గలవాడు ఎలా మాట్లాడతాడు, కూర్చుంటాడు, నడుస్తాడు?","hyperLink":"https://vedabase.io/en/library/bg/2/54/","manas":{"links":[{"label":"📖 BG 2.54 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/54/"}]}},{"id":"gita-ml-te-ch2-v55","topic":"2.55 · ఆత్మలో సంతృప్తి","note":"మనసు నుండి పుట్టే అన్ని భోగ కోరికలు వదిలి ఆత్మలోనే తృప్తి పొందేవాడు స్థితప్రజ్ఞుడు.","hyperLink":"https://vedabase.io/en/library/bg/2/55/","manas":{"links":[{"label":"📖 BG 2.55 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/55/"}]}},{"id":"gita-ml-te-ch2-v56","topic":"2.56 · స్థిరమైన ముని","note":"దుఃఖంలో చలించనివాడు, సుఖంలో పొంగనివాడు, ఆసక్తి, భయం, కోపం లేనివాడు స్థిరమైన ముని.","hyperLink":"https://vedabase.io/en/library/bg/2/56/","manas":{"links":[{"label":"📖 BG 2.56 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/56/"}]}},{"id":"gita-ml-te-ch2-v57","topic":"2.57 · పొగడ్త లేదు, ద్వేషం లేదు","note":"మంచి చెడు ఏది వచ్చినా సంతోషించక ద్వేషించక ఉండేవాని జ్ఞానం దృఢమైనది.","hyperLink":"https://vedabase.io/en/library/bg/2/57/","manas":{"links":[{"label":"📖 BG 2.57 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/57/"}]}},{"id":"gita-ml-te-ch2-v58","topic":"2.58 · తాబేలు లాగా","note":"తాబేలు అవయవాలు లోపలికి ముడుచుకున్నట్లు, ఇంద్రియాలను విషయాల నుండి వెనక్కి తీసేవాడు స్థిరుడు.","hyperLink":"https://vedabase.io/en/library/bg/2/58/","manas":{"links":[{"label":"📖 BG 2.58 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/58/"}]}},{"id":"gita-ml-te-ch2-v59","topic":"2.59 · ఉన్నతమైన రుచి","note":"విషయాలకు దూరంగా ఉన్నా రుచి మిగులుతుంది; ఉన్నత రుచి దొరికితే అదీ పోతుంది.","hyperLink":"https://vedabase.io/en/library/bg/2/59/","manas":{"links":[{"label":"📖 BG 2.59 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/59/"}]}},{"id":"gita-ml-te-ch2-v60","topic":"2.60 · ఇంద్రియాలు మనసును లాగుతాయి","note":"ప్రయత్నించే వివేకి మనసును కూడా బలవంతంగా లాగేంత బలమైనవి ఇంద్రియాలు.","hyperLink":"https://vedabase.io/en/library/bg/2/60/","manas":{"links":[{"label":"📖 BG 2.60 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/60/"}]}},{"id":"gita-ml-te-ch2-v61","topic":"2.61 · మనసు నాపై నిలుపు","note":"ఇంద్రియాలను అదుపులో ఉంచి కృష్ణునిపై మనసు నిలిపేవాని బుద్ధి స్థిరం.","hyperLink":"https://vedabase.io/en/library/bg/2/61/","manas":{"links":[{"label":"📖 BG 2.61 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/61/"}]}},{"id":"gita-ml-te-ch2-v62","topic":"2.62 · పతనపు మెట్లు (1)","note":"విషయాల ధ్యాస ఆసక్తిని తెస్తుంది; ఆసక్తి నుండి కామం, కామం నుండి కోపం పుడతాయి.","hyperLink":"https://vedabase.io/en/library/bg/2/62/","manas":{"links":[{"label":"📖 BG 2.62 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/62/"}],"q":"ఇంద్రియ విషయాల ధ్యాస ఏ క్రమంలో కోపానికి దారి తీస్తుంది?"}},{"id":"gita-ml-te-ch2-v63","topic":"2.63 · పతనపు మెట్లు (2)","note":"కోపం నుండి మోహం, మోహం నుండి స్మృతిభ్రంశం, దాని వల్ల బుద్ధినాశం, ఆపై పతనం.","hyperLink":"https://vedabase.io/en/library/bg/2/63/","manas":{"links":[{"label":"📖 BG 2.63 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/63/"}]}},{"id":"gita-ml-te-ch2-v64","topic":"2.64 · భగవంతుని కృప","note":"రాగద్వేషాలు లేక నియమాలతో ఇంద్రియాలను సాధించినవాడు భగవంతుని పూర్ణ కృప పొందుతాడు.","hyperLink":"https://vedabase.io/en/library/bg/2/64/","manas":{"links":[{"label":"📖 BG 2.64 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/64/"}]}},{"id":"gita-ml-te-ch2-v65","topic":"2.65 · దుఃఖాల అంతం","note":"అటువంటి ప్రసన్నతలో లోక దుఃఖాలు తొలగి బుద్ధి త్వరగా స్థిరపడుతుంది.","hyperLink":"https://vedabase.io/en/library/bg/2/65/","manas":{"links":[{"label":"📖 BG 2.65 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/65/"}]}},{"id":"gita-ml-te-ch2-v66","topic":"2.66 · సంబంధం లేక శాంతి లేదు","note":"పరమాత్మతో అనుసంధానం లేనివానికి స్థిరబుద్ధి, శాంతి ఉండవు; శాంతి లేక సుఖం ఎక్కడ?","hyperLink":"https://vedabase.io/en/library/bg/2/66/","manas":{"links":[{"label":"📖 BG 2.66 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/66/"}]}},{"id":"gita-ml-te-ch2-v67","topic":"2.67 · గాలి, పడవ","note":"బలమైన గాలి పడవను కొట్టుకుపోయేలా, తిరిగే ఒక్క ఇంద్రియం కూడా బుద్ధిని లాక్కుపోతుంది.","hyperLink":"https://vedabase.io/en/library/bg/2/67/","manas":{"links":[{"label":"📖 BG 2.67 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/67/"}]}},{"id":"gita-ml-te-ch2-v68","topic":"2.68 · నిగ్రహం గలవాని స్థిరబుద్ధి","note":"కాబట్టి ఇంద్రియాలను విషయాల నుండి నిగ్రహించినవాని బుద్ధి తప్పక స్థిరం.","hyperLink":"https://vedabase.io/en/library/bg/2/68/","manas":{"links":[{"label":"📖 BG 2.68 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/68/"}]}},{"id":"gita-ml-te-ch2-v69","topic":"2.69 · రాత్రి, మెలకువ","note":"అందరికీ రాత్రైనది నిగ్రహుడికి మెలకువ; అందరూ మేలుకొనేది మునికి రాత్రి.","hyperLink":"https://vedabase.io/en/library/bg/2/69/","manas":{"links":[{"label":"📖 BG 2.69 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/69/"}]}},{"id":"gita-ml-te-ch2-v70","topic":"2.70 · సముద్రం, నదులు","note":"నదులు నిండుతున్నా సముద్రం ప్రశాంతంగా ఉన్నట్లు, కోరికల మధ్య చలించనివాడే శాంతి పొందుతాడు.","hyperLink":"https://vedabase.io/en/library/bg/2/70/","manas":{"links":[{"label":"📖 BG 2.70 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/70/"}]}},{"id":"gita-ml-te-ch2-v71","topic":"2.71 · 'నాది' వదులు","note":"అన్ని కోరికలు, మమకారం, మిథ్యా అహంకారం వదిలినవాడే నిజమైన శాంతి పొందుతాడు.","hyperLink":"https://vedabase.io/en/library/bg/2/71/","manas":{"links":[{"label":"📖 BG 2.71 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/71/"}]}},{"id":"gita-ml-te-ch2-v72","topic":"2.72 · బ్రాహ్మీ స్థితి","note":"ఇదే ఆధ్యాత్మిక స్థితి; దీనిలో మోహం ఉండదు, మరణ సమయంలోనూ దీనిలో నిలిచినవాడు భగవంతుని రాజ్యం చేరతాడు.","hyperLink":"https://vedabase.io/en/library/bg/2/72/","manas":{"links":[{"label":"📖 BG 2.72 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/72/"}]}}]},{"id":"gita-ml-te-ch2-see","topic":"🔗 vedabase.io · తెలుగు","note":"Bhagavad-gita Chapter 2 on vedabase.io (English). The same chapter in the other nine languages is on this library's shelf.","hyperLink":"https://vedabase.io/en/library/bg/2/","manas":{"links":[{"label":"📖 BG 2 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/"}]}}]}},"part":"te","updated":1795357904858,"created":1795357904858}]}