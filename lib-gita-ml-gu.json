https://vedabase.io/en/library/bg/2/42-43/"}]}},{"id":"gita-ml-gu-ch2-v44","topic":"2.44 · ભોગમાં દૃઢતા નથી","note":"જે ભોગ અને ઐશ્વર્યમાં ફસાયા છે, તેમના મનમાં ભગવાનની ભક્તિનો દૃઢ નિશ્ચય બનતો નથી.","hyperLink":"https://vedabase.io/en/library/bg/2/44/","manas":{"links":[{"label":"📖 BG 2.44 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/44/"}]}},{"id":"gita-ml-gu-ch2-v45","topic":"2.45 · ત્રણ ગુણોથી ઉપર ઊઠો","note":"વેદ મુખ્યત્વે ત્રણ ગુણોની વાત કરે છે; તેનાથી ઉપર ઊઠો, દ્વંદ્વ અને ચિંતા છોડી આત્મામાં સ્થિર રહો.","hyperLink":"https://vedabase.io/en/library/bg/2/45/","manas":{"links":[{"label":"📖 BG 2.45 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/45/"}]}},{"id":"gita-ml-gu-ch2-v46","topic":"2.46 · કૂવો અને સરોવર","note":"નાના કૂવાનું કામ મોટા જળાશયથી થઈ જાય છે; વેદનો હેતુ જાણનારને બધું મળી જાય છે.","hyperLink":"https://vedabase.io/en/library/bg/2/46/","manas":{"links":[{"label":"📖 BG 2.46 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/46/"}]}},{"id":"gita-ml-gu-ch2-v47","topic":"2.47 · કર્મ તમારું, ફળ નહીં","note":"તમારો અધિકાર કર્મ પર છે, ફળ પર નહીં; પોતાને ફળનું કારણ ન માનો, અને કર્મ ન કરવામાં પણ આસક્તિ ન રાખો.","hyperLink":"https://vedabase.io/en/library/bg/2/47/","manas":{"links":[{"label":"📖 BG 2.47 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/47/"}],"q":"કર્મ અને ફળ વિશે કૃષ્ણ શું કહે છે?"}},{"id":"gita-ml-gu-ch2-v48","topic":"2.48 · સમત્વ એ જ યોગ","note":"સફળતા-નિષ્ફળતાની આસક્તિ છોડી સમભાવે કર્મ કરો; આ સમતા જ યોગ છે.","hyperLink":"https://vedabase.io/en/library/bg/2/48/","manas":{"links":[{"label":"📖 BG 2.48 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/48/"}]}},{"id":"gita-ml-gu-ch2-v49","topic":"2.49 · ફળ માટે કામ એ કંજૂસાઈ","note":"ભક્તિથી હલકાં કર્મ દૂર રાખો અને ભગવાનનું શરણ લો; ફક્ત ફળ ઇચ્છનારા કૃપણ છે.","hyperLink":"https://vedabase.io/en/library/bg/2/49/","manas":{"links":[{"label":"📖 BG 2.49 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/49/"}]}},{"id":"gita-ml-gu-ch2-v50","topic":"2.50 · યોગ: કર્મની કુશળતા","note":"ભક્તિમાં લાગેલો માણસ આ જીવનમાં જ સારાં-નરસાં બંને ફળથી છૂટે છે; યોગ કર્મની કળા છે.","hyperLink":"https://vedabase.io/en/library/bg/2/50/","manas":{"links":[{"label":"📖 BG 2.50 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/50/"}]}},{"id":"gita-ml-gu-ch2-v51","topic":"2.51 · જન્મ-મૃત્યુથી પર","note":"આવા ઋષિ-ભક્તો કર્મફળથી મુક્ત થઈ જન્મ-મૃત્યુના ચક્રમાંથી છૂટે છે અને દુઃખથી પર પહોંચે છે.","hyperLink":"https://vedabase.io/en/library/bg/2/51/","manas":{"links":[{"label":"📖 BG 2.51 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/51/"}]}},{"id":"gita-ml-gu-ch2-v52","topic":"2.52 · મોહના જંગલમાંથી બહાર","note":"બુદ્ધિ મોહના ગાઢ વનને પાર કરશે ત્યારે સાંભળેલી અને સાંભળવાની વાતોથી તમે ઉદાસીન થઈ જશો.","hyperLink":"https://vedabase.io/en/library/bg/2/52/","manas":{"links":[{"label":"📖 BG 2.52 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/52/"}]}},{"id":"gita-ml-gu-ch2-v53","topic":"2.53 · સમાધિમાં સ્થિર","note":"મન વેદના આકર્ષક શબ્દોથી ડગે નહીં અને આત્મસાક્ષાત્કારમાં ટકે, ત્યારે તમે યોગ પામશો.","hyperLink":"https://vedabase.io/en/library/bg/2/53/","manas":{"links":[{"label":"📖 BG 2.53 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/53/"}]}}]},{"id":"gita-ml-gu-ch2-s5","topic":"2.54–72 · સ્થિર બુદ્ધિવાળો માણસ","note":"2.54–72 · સ્થિર બુદ્ધિવાળો માણસ · BG 2.54–72","hyperLink":"https://vedabase.io/en/library/bg/2/","manas":{"links":[{"label":"📖 BG 2 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/"}]},"children":[{"id":"gita-ml-gu-ch2-v54","topic":"2.54 · અર્જુનનો પ્રશ્ન","note":"અર્જુન પૂછે છે: સ્થિર બુદ્ધિવાળો કેવી રીતે બોલે, બેસે અને ચાલે છે?","hyperLink":"https://vedabase.io/en/library/bg/2/54/","manas":{"links":[{"label":"📖 BG 2.54 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/54/"}]}},{"id":"gita-ml-gu-ch2-v55","topic":"2.55 · આત્મામાં સંતુષ્ટ","note":"જે મન