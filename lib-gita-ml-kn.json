s://vedabase.io/en/library/bg/1/25/","manas":{"links":[{"label":"📖 BG 1.25 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/25/"}]}},{"id":"gita-ml-kn-ch1-v26","topic":"1.26 · ಎರಡೂ ಕಡೆ ತನ್ನವರೇ","note":"ಎರಡೂ ಸೈನ್ಯಗಳಲ್ಲಿ ಅರ್ಜುನ ತಂದೆಯರು, ಅಜ್ಜಂದಿರು, ಗುರುಗಳು, ಸೋದರಮಾವಂದಿರು, ಸಹೋದರರು, ಮಕ್ಕಳು, ಸ್ನೇಹಿತರು, ಮಾವಂದಿರನ್ನು ನೋಡುತ್ತಾನೆ.","hyperLink":"https://vedabase.io/en/library/bg/1/26/","manas":{"links":[{"label":"📖 BG 1.26 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/26/"}],"q":"ಎರಡೂ ಸೈನ್ಯಗಳಲ್ಲಿ ಅರ್ಜುನ ಯಾರನ್ನು ನೋಡಿದನು?"}},{"id":"gita-ml-kn-ch1-v27","topic":"1.27 · ಕರುಣೆಯಿಂದ ತುಂಬಿದ","note":"ತನ್ನ ಬಂಧುಗಳನ್ನೇ ಕಂಡು ಅರ್ಜುನ ಕರುಣೆಯಿಂದ ತುಂಬಿಹೋಗುತ್ತಾನೆ.","hyperLink":"https://vedabase.io/en/library/bg/1/27/","manas":{"links":[{"label":"📖 BG 1.27 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/27/"}]}},{"id":"gita-ml-kn-ch1-v28","topic":"1.28 · ಅಂಗಗಳು ನಡುಗುತ್ತಿವೆ","note":"ಅರ್ಜುನ ಹೇಳುತ್ತಾನೆ: ನನ್ನವರನ್ನು ಯುದ್ಧಕ್ಕೆ ಸಿದ್ಧರಾಗಿ ಕಂಡು ನನ್ನ ಅಂಗಗಳು ನಡುಗುತ್ತಿವೆ, ಬಾಯಿ ಒಣಗುತ್ತಿದೆ.","hyperLink":"https://vedabase.io/en/library/bg/1/28/","manas":{"links":[{"label":"📖 BG 1.28 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/28/"}]}},{"id":"gita-ml-kn-ch1-v29","topic":"1.29 · ಗಾಂಡೀವ ಜಾರುತ್ತಿದೆ","note":"ದೇಹ ನಡುಗುತ್ತಿದೆ, ರೋಮಾಂಚನವಾಗಿದೆ, ಗಾಂಡೀವ ಕೈಯಿಂದ ಜಾರುತ್ತಿದೆ, ಚರ್ಮ ಉರಿಯುತ್ತಿದೆ.","hyperLink":"https://vedabase.io/en/library/bg/1/29/","manas":{"links":[{"label":"📖 BG 1.29 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/29/"}]}}]},{"id":"gita-ml-kn-ch1-s4","topic":"1.28–46 · ಅರ್ಜುನನ ದುಃಖ","note":"1.28–46 · ಅರ್ಜುನನ ದುಃಖ · BG 1.30–46","hyperLink":"https://vedabase.io/en/library/bg/1/","manas":{"links":[{"label":"📖 BG 1 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/"}]},"children":[{"id":"gita-ml-kn-ch1-v30","topic":"1.30 · ಮನಸ್ಸು ತಿರುಗುತ್ತಿದೆ","note":"ಅವನಿಗೆ ನಿಲ್ಲಲಾಗುತ್ತಿಲ್ಲ, ಮನಸ್ಸು ತಿರುಗುತ್ತಿದೆ, ಅಪಶಕುನಗಳೇ ಕಾಣುತ್ತಿವೆ.","hyperLink":"https://vedabase.io/en/library/bg/1/30/","manas":{"links":[{"label":"📖 BG 1.30 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/30/"}]}},{"id":"gita-ml-kn-ch1-v31","topic":"1.31 · ಗೆಲುವು ಬೇಡ","note":"ತನ್ನ ಬಂಧುಗಳನ್ನು ಕೊಲ್ಲುವುದರಲ್ಲಿ ಅವನಿಗೆ ಯಾವ ಒಳಿತೂ ಕಾಣುವುದಿಲ್ಲ; ಗೆಲುವಾಗಲಿ ರಾಜ್ಯವಾಗಲಿ ಬೇಡ.","hyperLink":"https://vedabase.io/en/library/bg/1/31/","manas":{"links":[{"label":"📖 BG 1.31 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/31/"}],"q":"ಯುದ್ಧದಲ್ಲಿ ಅರ್ಜುನನಿಗೆ ಒಳಿತು ಏಕೆ ಕಾಣಲಿಲ್ಲ?"}},{"id":"gita-ml-kn-ch1-v32-35","topic":"1.32-35 · ರಾಜ್ಯ ಏಕೆ","note":"ಯಾರಿಗಾಗಿ ರಾಜ್ಯ, ಸುಖ ಬೇಕೋ ಅವರೇ ಇಲ್ಲಿ ಸಾಯಲು ನಿಂತಿದ್ದಾರೆ; ಮೂರು ಲೋಕಗಳಿಗಾಗಿಯೂ ಅವನು ಅವರನ್ನು ಕೊಲ್ಲುವುದಿಲ್ಲ.","hyperLink":"https://vedabase.io/en/library/bg/1/32-35/","manas":{"links":[{"label":"📖 BG 1.32-35 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/32-35/"}]}},{"id":"gita-ml-kn-ch1-v36","topic":"1.36 · ಪಾಪ ತಟ್ಟುತ್ತದೆ","note":"ಇವರನ್ನು ಕೊಂದರೆ ಪಾಪ ತಟ್ಟುತ್ತದೆ; ನಮ್ಮವರನ್ನೇ ಕೊಂದು ನಾವು ಹೇಗೆ ಸುಖಿಗಳಾಗುತ್ತೇವೆ?","hyperLink":"https://vedabase.io/en/library/bg/1/36/","manas":{"links":[{"label":"📖 BG 1.36 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/36/"}]}},{"id":"gita-ml-kn-ch1-v37-38","topic":"1.37-38 · ಲೋಭದಿಂದ ಕುರುಡರು","note":"ಅವರು ಲೋಭದಿಂದ ಕುರುಡರಾಗಿದ್ದಾರೆ, ಆದರೆ ಕುಲನಾಶದ ದೋಷ ನಮಗೆ ಕಾಣುತ್ತದೆ — ಹಾಗಾದರೆ ನಾವೇಕೆ ಹೀಗೆ ಮಾಡಬೇಕು?","hyperLink":"https://vedabase.io/en/library/bg/1/37-38/","manas":{"links":[{"label":"📖 BG 1.37-38 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/37-38/"}]}},{"id":"gita-ml-kn-ch1-v39","topic":"1.39 · ಕುಲಧರ್ಮ ನಾಶ","note":"ಕುಲ ನಾಶವಾದರೆ ಅದರ ಶಾಶ್ವತ ಸಂಪ್ರದಾಯಗಳು ಅಳಿದು ಅಧರ್ಮ ಹರಡುತ್ತದೆ.","hyperLink":"https://vedabase.io/en/library/bg/1/39/","manas":{"links":[{"label":"📖 BG 1.39 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/39/"}]}},{"id":"gita-ml-kn-ch1-v40","topic":"1.40 · ಅಧರ್ಮದ ಫಲ","note":"ಅಧರ್ಮ ಹೆಚ್ಚಿದರೆ ಕುಟುಂಬದ ನಡವಳಿಕೆ ಕೆಡುತ್ತದೆ, ಬೇಡದ ಸಂತಾನ ಹುಟ್ಟುತ್ತದೆ.","hyperLink":"https://vedabase.io/en/library/bg/1/40/","manas":{"links":[{"label":"📖 BG 1.40 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/40/"}]}},{"id":"gita-ml-kn-ch1-v41","topic":"1.41 · ಪಿತೃಗಳ ಪತನ","note":"ಇದರಿಂದ ಕುಟುಂಬಕ್ಕೂ ಅದನ್ನು ನಾಶಮಾಡಿದವರಿಗೂ ನರಕದಂತಹ ಬದುಕು; ಪಿತೃಗಳಿಗೆ ತರ್ಪಣ ಸಿಗುವುದಿಲ್ಲ.","hyperLink":"https://vedabase.io/en/library/bg/1/41/","manas":{"links":[{"label":"📖 BG 1.41 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/41/"}]}},{"id":"gita-ml-kn-ch1-v42","topic":"1.42 · ಕಲ್ಯಾಣ ಕಾರ್ಯಗಳ ನಾಶ","note":"ಕುಲನಾಶಕರ ದುಷ್ಕೃತ್ಯಗಳಿಂದ ಸಮಾಜ ಮತ್ತು ಕುಟುಂಬದ ಎಲ್ಲ ಕಲ್ಯಾಣ ಕಾರ್ಯಗಳು ನಾಶವಾಗುತ್ತವೆ.","hyperLink":"https://vedabase.io/en/library/bg/1/42/","manas":{"links":[{"label":"📖 BG 1.42 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/42/"}]}},{"id":"gita-ml-kn-ch1-v43","topic":"1.43 · ಪರಂಪರೆಯಿಂದ ಕೇಳಿದ್ದು","note":"ಅಂಥವರು ನರಕದಲ್ಲಿ ವಾಸಿಸುತ್ತಾರೆ ಎಂದು ಅರ್ಜುನ ಗುರುಪರಂಪರೆಯಿಂದ ಕೇಳಿದ್ದಾನೆ.","hyperLink":"https://vedabase.io/en/library/bg/1/43/","manas":{"links":[{"label":"📖 BG 1.43 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/43/"}]}},{"id":"gita-ml-kn-ch1-v44","topic":"1.44 · ಎಷ್ಟು ವಿಚಿತ್ರ","note":"ರಾಜಸುಖದ ಆಸೆಯಿಂದ ನಮ್ಮವರನ್ನೇ ಕೊಲ್ಲಲು ಹೊರಟಿದ್ದೇವೆ, ಎಷ್ಟು ವಿಚಿತ್ರ!","hyperLink":"https://vedabase.io/en/library/bg/1/44/","manas":{"links":[{"label":"📖 BG 1.44 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/44/"}]}},{"id":"gita-ml-kn-ch1-v45","topic":"1.45 · ನನ್ನನ್ನೇ ಕೊಲ್ಲಲಿ","note":"ನಿರಾಯುಧನಾಗಿ ಎದುರಿಸದ ನನ್ನನ್ನು ಧೃತರಾಷ್ಟ್ರನ ಮಕ್ಕಳು ಕೊಂದರೂ ಅದೇ ಮೇಲು.","hyperLink":"https://vedabase.io/en/library/bg/1/45/","manas":{"links":[{"label":"📖 BG 1.45 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/45/"}]}},{"id":"gita-ml-kn-ch1-v46","topic":"1.46 · ಬಿಲ್ಲು ಕೆಳಗಿಟ್ಟ","note":"ಸಂಜಯ ಹೇಳುತ್ತಾನೆ: ಅರ್ಜುನ ಬಿಲ್ಲು ಬಾಣಗಳನ್ನು ಬಿಟ್ಟು, ದುಃಖದಿಂದ ತುಂಬಿದ ಮನಸ್ಸಿನಿಂದ ರಥದಲ್ಲಿ ಕುಳಿತುಕೊಳ್ಳುತ್ತಾನೆ.","hyperLink":"https://vedabase.io/en/library/bg/1/46/","manas":{"links":[{"label":"📖 BG 1.46 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/46/"}],"q":"ಅಧ್ಯಾಯದ ಕೊನೆಯಲ್ಲಿ ಅರ್ಜುನ ಏನು ಮಾಡಿದನು?"}}]},{"id":"gita-ml-kn-ch1-see","topic":"🔗 vedabase.io · ಕನ್ನಡ","note":"Bhagavad-gita Chapter 1 on vedabase.io (English). The same chapter in the other nine languages is on this library's shelf.","hyperLink":"https://vedabase.io/en/library/bg/1/","manas":{"links":[{"label":"📖 BG 1 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/"}]}}]}},"part":"kn","updated":1794997500456,"created":1794997500456}]}