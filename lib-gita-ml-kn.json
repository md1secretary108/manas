/en/library/bg/1/15/"}],"q":"ಕೃಷ್ಣ, ಅರ್ಜುನ, ಭೀಮ ಊದಿದ ಶಂಖಗಳ ಹೆಸರುಗಳು ಯಾವುವು?"}},{"id":"gita-ml-kn-ch1-v16-18","topic":"1.16-18 · ಇತರ ಪಾಂಡವರ ಶಂಖಗಳು","note":"ಯುಧಿಷ್ಠಿರ, ನಕುಲ, ಸಹದೇವ ಮತ್ತು ಪಾಂಡವರ ಇತರ ಮಿತ್ರರೂ ತಮ್ಮ ಶಂಖಗಳನ್ನು ಊದುತ್ತಾರೆ.","hyperLink":"https://vedabase.io/en/library/bg/1/16-18/","manas":{"links":[{"label":"📖 BG 1.16-18 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/16-18/"}]}},{"id":"gita-ml-kn-ch1-v19","topic":"1.19 · ಭೂಮಿ ಆಕಾಶ ಮೊಳಗಿದವು","note":"ಆ ನಾದ ಭೂಮಿ ಆಕಾಶಗಳಲ್ಲಿ ಪ್ರತಿಧ್ವನಿಸಿ ಧೃತರಾಷ್ಟ್ರನ ಮಕ್ಕಳ ಹೃದಯಗಳನ್ನು ನಡುಗಿಸುತ್ತದೆ.","hyperLink":"https://vedabase.io/en/library/bg/1/19/","manas":{"links":[{"label":"📖 BG 1.19 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/19/"}]}},{"id":"gita-ml-kn-ch1-v20","topic":"1.20 · ಹನುಮಧ್ವಜ","note":"ಹನುಮಂತನ ಚಿಹ್ನೆಯಿರುವ ಧ್ವಜದ ಕೆಳಗೆ ಅರ್ಜುನ ಬಿಲ್ಲು ಎತ್ತಿ ಕೃಷ್ಣನೊಡನೆ ಮಾತನಾಡುತ್ತಾನೆ.","hyperLink":"https://vedabase.io/en/library/bg/1/20/","manas":{"links":[{"label":"📖 BG 1.20 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/20/"}]}}]},{"id":"gita-ml-kn-ch1-s3","topic":"1.20–27 · ಅರ್ಜುನ ಎರಡೂ ಸೈನ್ಯಗಳನ್ನು ನೋಡುತ್ತಾನೆ","note":"1.20–27 · ಅರ್ಜುನ ಎರಡೂ ಸೈನ್ಯಗಳನ್ನು ನೋಡುತ್ತಾನೆ · BG 1.21–29","hyperLink":"https://vedabase.io/en/library/bg/1/","manas":{"links":[{"label":"📖 BG 1 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/"}]},"children":[{"id":"gita-ml-kn-ch1-v21-22","topic":"1.21-22 · ರಥವನ್ನು ಮಧ್ಯೆ ನಿಲ್ಲಿಸು","note":"ಯಾರೊಡನೆ ಹೋರಾಡಬೇಕೆಂದು ನೋಡಲು ರಥವನ್ನು ಎರಡೂ ಸೈನ್ಯಗಳ ಮಧ್ಯೆ ನಿಲ್ಲಿಸುವಂತೆ ಅರ್ಜುನ ಕೃಷ್ಣನನ್ನು ಕೇಳುತ್ತಾನೆ.","hyperLink":"https://vedabase.io/en/library/bg/1/21-22/","manas":{"links":[{"label":"📖 BG 1.21-22 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/21-22/"}],"q":"ರಥವನ್ನು ಎಲ್ಲಿ ನಿಲ್ಲಿಸಲು ಅರ್ಜುನ ಕೃಷ್ಣನನ್ನು ಕೇಳಿದನು?"}},{"id":"gita-ml-kn-ch1-v23","topic":"1.23 · ಯಾರು ಹೋರಾಡಲು ಬಂದಿದ್ದಾರೆ","note":"ದುರ್ಯೋಧನನನ್ನು ಮೆಚ್ಚಿಸಲು ಯಾರ್ಯಾರು ಬಂದಿದ್ದಾರೆ ಎಂದು ನೋಡಲು ಅವನು ಬಯಸುತ್ತಾನೆ.","hyperLink":"https://vedabase.io/en/library/bg/1/23/","manas":{"links":[{"label":"📖 BG 1.23 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/23/"}]}},{"id":"gita-ml-kn-ch1-v24","topic":"1.24 · ರಥ ಮಧ್ಯದಲ್ಲಿ","note":"ಕೃಷ್ಣ ರಥವನ್ನು ಎರಡೂ ಸೈನ್ಯಗಳ ಮಧ್ಯೆ ಕೊಂಡೊಯ್ದು ನಿಲ್ಲಿಸುತ್ತಾನೆ.","hyperLink":"https://vedabase.io/en/library/bg/1/24/","manas":{"links":[{"label":"📖 BG 1.24 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/24/"}]}},{"id":"gita-ml-kn-ch1-v25","topic":"1.25 · ಕುರುಗಳನ್ನು ನೋಡು","note":"ಭೀಷ್ಮ ದ್ರೋಣರ ಎದುರು ಕೃಷ್ಣ ಹೇಳುತ್ತಾನೆ: ಪಾರ್ಥ, ಇಲ್ಲಿ ಸೇರಿರುವ ಎಲ್ಲ ಕುರುಗಳನ್ನು ನೋಡು.","hyperLink":"https://vedabase.io/en/library/bg/1/25/","manas":{"links":[{"label":"📖 BG 1.25 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/25/"}]}},{"id":"gita-ml-kn-ch1-v26","topic":"1.26 · ಎರಡೂ ಕಡೆ ತನ್ನವರೇ","note":"ಎರಡೂ ಸೈನ್ಯಗಳಲ್ಲಿ ಅರ್ಜುನ ತಂದೆಯರು, ಅಜ್ಜಂದಿರು, ಗುರುಗಳು, ಸೋದರಮಾವಂದಿರು, ಸಹೋದರರು, ಮಕ್ಕಳು, ಸ್ನೇಹಿತರು, ಮಾವಂದಿರನ್ನು ನೋಡುತ್ತಾನೆ.","hyperLink":"https://vedabase.io/en/library/bg/1/26/","manas":{"links":[{"label":"📖 BG 1.26 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/26/"}],"q":"ಎರಡೂ ಸೈನ್ಯಗಳಲ್ಲಿ ಅರ್ಜುನ ಯಾರನ್ನು ನೋಡಿದನು?"}},{"id":"gita-ml-kn-ch1-v27","topic":"1.27 · ಕರುಣೆಯಿಂದ ತುಂಬಿದ","note":"ತನ್ನ ಬಂಧುಗಳನ್ನೇ ಕಂಡು ಅರ್ಜುನ ಕರುಣೆಯಿಂದ ತುಂಬಿಹೋಗುತ್ತಾನೆ.","hyperLink":"https://vedabase.io/en/library/bg/1/27/","manas":{"links":[{"label":"📖 BG 1.27 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/27/"}]}},{"id":"gita-ml-kn-ch1-v28","topic":"1.28 · ಅಂಗಗಳು ನಡುಗುತ್ತಿವೆ","note":"ಅರ್ಜುನ ಹೇಳುತ್ತಾನೆ: ನನ್ನವರನ್ನು ಯುದ್ಧಕ್ಕೆ ಸಿದ್ಧರಾಗಿ ಕಂಡು ನನ್ನ ಅಂಗಗಳು ನಡುಗುತ್ತಿವೆ, ಬಾಯಿ ಒಣಗುತ್ತಿದೆ.","hyperLink":"https://vedabase.io/en/library/bg/1/28/","manas":{"links":[{"label":"📖 BG 1.28 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/28/"}]}},{"id":"gita-ml-kn-ch1-v29","topic":"1.29 · ಗಾಂಡೀವ ಜಾರುತ್ತಿದೆ","note":"ದೇಹ ನಡುಗುತ್ತಿದೆ, ರೋಮಾಂಚನವಾಗಿದೆ, ಗಾಂಡೀವ ಕೈಯಿಂದ ಜಾರುತ್ತಿದೆ, ಚರ್ಮ ಉರಿಯುತ್ತಿದೆ.","hyperLink":"https://vedabase.io/en/library/bg/1/29/","manas":{"links":[{"label":"📖 BG 1.29 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/29/"}]}}]},{"id":"gita-ml-kn-ch1-s4","topic":"1.28–46 · ಅರ್ಜುನನ ದುಃಖ","note":"1.28–46 · ಅರ್ಜುನನ ದುಃಖ · BG 1.30–46","hyperLink":"https://vedabase.io/en/library/bg/1/","manas":{"links":[{"label":"📖 BG 1 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/"}]},"children":[{"id":"gita-ml-kn-ch1-v30","topic":"1.30 · ಮನಸ್ಸು ತಿರುಗುತ್ತಿದೆ","note":"ಅವನಿಗೆ ನಿಲ್ಲಲಾಗುತ್ತಿಲ್ಲ, ಮನಸ್ಸು ತಿರುಗುತ್ತಿದೆ, ಅಪಶಕುನಗಳೇ ಕಾಣುತ್ತಿವೆ.","hyperLink":"https://vedabase.io/en/library/bg/1/30/","manas":{"links":[{"label":"📖 BG 1.30 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/30/"}]}},{"id":"gita-ml-kn-ch1-v31","topic":"1.31 · ಗೆಲುವು ಬೇಡ","note":"ತನ್ನ ಬಂಧುಗಳನ್ನು ಕೊಲ್ಲುವುದರಲ್ಲಿ ಅವನಿಗೆ ಯಾವ ಒಳಿತೂ ಕಾಣುವುದಿಲ್ಲ; ಗೆಲುವಾಗಲಿ ರಾಜ್ಯವಾಗಲಿ ಬೇಡ.","hyperLink":"https://vedabase.io/en/library/bg/1/31/","manas":{"links":[{"label":"📖 BG 1.31 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/31/"}],"q":"ಯುದ್ಧದಲ್ಲಿ ಅರ್ಜುನನಿಗೆ ಒಳಿತು ಏಕೆ ಕಾಣಲಿಲ್ಲ?"}},{"id":"gita-ml-kn-ch1-v32-35","topic":"1.32-35 · ರಾಜ್ಯ ಏಕೆ","note":"ಯಾರಿಗಾಗಿ ರಾಜ್ಯ, ಸುಖ ಬೇಕೋ ಅವರೇ ಇಲ್ಲಿ ಸಾಯಲು ನಿಂತಿದ್ದಾರೆ; ಮೂರು ಲೋಕಗಳಿಗಾಗಿಯೂ ಅವನು ಅವರನ್ನು ಕೊಲ್ಲುವುದಿಲ್ಲ.","hyperLink":"https://vedabase.io/en/library/bg/1/32-35/","manas":{"links":[{"label":"📖 BG 1.32-35 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/32-35/"}]}},{"id":"gita-ml-kn-ch1-v36","topic":"1.36 · ಪಾಪ ತಟ್ಟುತ್ತದೆ","note":"ಇವರನ್ನು ಕೊಂದರೆ ಪಾಪ ತಟ್ಟುತ್ತದೆ; ನಮ್ಮವರನ್ನೇ ಕೊಂದು ನಾವು ಹೇಗೆ ಸುಖಿಗಳಾಗುತ್ತೇವೆ?","hyperLink":"https://vedabase.io/en/library/bg/1/36/","manas":{"links":[{"label":"📖 BG 1.36 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/36/"}]}},{"id":"gita-ml-kn-ch1-v37-38","topic":"1.37-38 · ಲೋಭದಿಂದ ಕುರುಡರು","note":"ಅವರು ಲೋಭದಿಂದ ಕುರುಡರಾಗಿದ್ದಾರೆ, ಆದರೆ ಕುಲನಾಶದ ದೋಷ ನಮಗೆ ಕಾಣುತ್ತದೆ — ಹಾಗಾದರೆ ನಾವೇಕೆ ಹೀಗೆ ಮಾಡಬೇಕು?","hyperLink":"https://vedabase.io/en/library/bg/1/37-38/","manas":{"links":[{"label":"📖 BG 1.37-38 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/37-38/"}]}},{"id":"gita-ml-kn-ch1-v39","topic":"1.39 · ಕುಲಧರ್ಮ ನಾಶ","note":"ಕುಲ ನಾಶವಾದರೆ ಅದರ ಶಾಶ್ವತ ಸಂಪ್ರದಾಯಗಳು ಅಳಿದು ಅಧರ್ಮ ಹರಡುತ್ತದೆ.","hyperLink":"https://vedabase.io/en/library/bg/1/39/","manas":{"links":[{"label":"📖 BG 1.39 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/39/"}]}},{"id":"gita-ml-kn-ch1-v40","topic":"1.40 · ಅಧರ್ಮದ ಫಲ","note":"ಅಧರ್ಮ ಹೆಚ್ಚಿದರೆ ಕುಟುಂಬದ ನಡವಳಿಕೆ ಕೆಡುತ್ತದೆ, ಬೇಡದ ಸಂತಾನ ಹುಟ್ಟುತ್ತದೆ.","hyperLink":"https://vedabase.io/en/library/bg/1/40/","manas":{"links":[{"label":"📖 BG 1.40 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/40/"}]}},{"id":"gita-ml-kn-ch1-v41","topic":"1.41 · ಪಿತೃಗಳ ಪತನ","note":"ಇದರಿಂದ ಕುಟುಂಬಕ್ಕೂ ಅದನ್ನು ನಾಶಮಾಡಿದವರಿಗೂ ನರಕದಂತಹ ಬದುಕು; ಪಿತೃಗಳಿಗೆ ತರ್ಪಣ ಸಿಗುವುದಿಲ್ಲ.","hyperLink":"https://vedabase.io/en/library/bg/1/41/","manas":{"links":[{"label":"📖 BG 1.41 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/41/"}]}},{"id":"gita-ml-kn-ch1-v42","topic":"1.42 · ಕಲ್ಯಾಣ ಕಾರ್ಯಗಳ ನಾಶ","note":"ಕುಲನಾಶಕರ ದುಷ್ಕೃತ್ಯಗಳಿಂದ ಸಮಾಜ ಮತ್ತು ಕುಟುಂಬದ ಎಲ್ಲ ಕಲ್ಯಾಣ ಕಾರ್ಯಗಳು ನಾಶವಾಗುತ್ತವೆ.","hyperLink":"https://vedabase.io/en/library/bg/1/42/","manas":{"links":[{"label":"📖 BG 1.42 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/42/"}]}},{"id":"gita-ml-kn-ch1-v43","topic":"1.43 · ಪರಂಪರೆಯಿಂದ ಕೇಳಿದ್ದು","note":"ಅಂಥವರು ನರಕದಲ್ಲಿ ವಾಸಿಸುತ್ತಾರೆ ಎಂದು ಅರ್ಜುನ ಗುರುಪರಂಪರೆಯಿಂದ ಕೇಳಿದ್ದಾನೆ.","hyperLink":"https://vedabase.io/en/library/bg/1/43/","manas":{"links":[{"label":"📖 BG 1.43 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/43/"}]}},{"id":"gita-ml-kn-ch1-v44","topic":"1.44 · ಎಷ್ಟು ವಿಚಿತ್ರ","note":"ರಾಜಸುಖದ ಆಸೆಯಿಂದ ನಮ್ಮವರನ್ನೇ ಕೊಲ್ಲಲು ಹೊರಟಿದ್ದೇವೆ, ಎಷ್ಟು ವಿಚಿತ್ರ!","hyperLink":"https://vedabase.io/en/library/bg/1/44/","manas":{"links":[{"label":"📖 BG 1.44 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/44/"}]}},{"id":"gita-ml-kn-ch1-v45","topic":"1.45 · ನನ್ನನ್ನೇ ಕೊಲ್ಲಲಿ","note":"ನಿರಾಯುಧನಾಗಿ ಎದುರಿಸದ ನನ್ನನ್ನು ಧೃತರಾಷ್ಟ್ರನ ಮಕ್ಕಳು ಕೊಂದರೂ ಅದೇ ಮೇಲು.","hyperLink":"https://vedabase.io/en/library/bg/1/45/","manas":{"links":[{"label":"📖 BG 1.45 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/45/"}]}},{"id":"gita-ml-kn-ch1-v46","topic":"1.46 · ಬಿಲ್ಲು ಕೆಳಗಿಟ್ಟ","note":"ಸಂಜಯ ಹೇಳುತ್ತಾನೆ: ಅರ್ಜುನ ಬಿಲ್ಲು ಬಾಣಗಳನ್ನು ಬಿಟ್ಟು, ದುಃಖದಿಂದ ತುಂಬಿದ ಮನಸ್ಸಿನಿಂದ ರಥದಲ್ಲಿ ಕುಳಿತುಕೊಳ್ಳುತ್ತಾನೆ.","hyperLink":"https://vedabase.io/en/library/bg/1/46/","manas":{"links":[{"label":"📖 BG 1.46 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/46/"}],"q":"ಅಧ್ಯಾಯದ ಕೊನೆಯಲ್ಲಿ ಅರ್ಜುನ ಏನು ಮಾಡಿದನು?"}}]},{"id":"gita-ml-kn-ch1-see","topic":"🔗 vedabase.io · ಕನ್ನಡ","note":"Bhagavad-gita Chapter 1 on vedabase.io (English). The same chapter in the other nine languages is on this library's shelf.","hyperLink":"https://vedabase.io/en/library/bg/1/","manas":{"links":[{"label":"📖 BG 1 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/1/"}]}}]}},"part":"kn","updated":1795357904858,"created":1795357904858},{"id":"gita-ml-kn-ch2","title":"ಕನ್ನಡ · ಅಧ್ಯಾಯ 2 · ಆತ್ಮ, ಕರ್ತವ್ಯ ಮತ್ತು ಸ್ಥಿರ ಬುದ್ಧಿ","look":"paper","layout":"side","library":"gita-ml","data":{"direction":2,"nodeData":{"id":"gita-ml-kn-ch2-root","topic":"ಅಧ್ಯಾಯ 2 · ಆತ್ಮ, ಕರ್ತವ್ಯ ಮತ್ತು ಸ್ಥಿರ ಬುದ್ಧಿ","note":"ಭಗವದ್ಗೀತೆ ಅಧ್ಯಾಯ 2 ರ ಪ್ರತಿಯೊಂದು ಶ್ಲೋಕಕ್ಕೂ ನಮ್ಮದೇ ಒಂದು ಸಾಲಿನ ಸಾರಾಂಶ, ಕನ್ನಡದಲ್ಲಿ. ಪ್ರತಿ ಗುಳ್ಳೆಯೂ vedabase.io ನಲ್ಲಿನ ಆ ಶ್ಲೋಕಕ್ಕೆ ಲಿಂಕ್ ಆಗಿದೆ (ಅಲ್ಲಿ ಕನ್ನಡ ಆವೃತ್ತಿ ಇಲ್ಲ, ಆದ್ದರಿಂದ ಇಂಗ್ಲಿಷ್ ಪುಟ). ಕರಡು: ಅನುವಾದ ಪರಿಶೀಲನೆಯಾಗಿಲ್ಲ — ಕನ್ನಡ ಮಾತೃಭಾಷಿಕ ಪರಿಶೀಲಕರು ಬೇಕು. · Draft · translation unreviewed · a native Kannada reviewer is wanted. Our own one-line summaries, not the BBT translation. Search words: ಗೀತೆ, ಭಗವದ್ಗೀತೆ, ಅರ್ಜುನ, ಕೃಷ್ಣ, ಕುರುಕ್ಷೇತ್ರ, ಶ್ಲೋಕ, Bhagavad-gita, Gita, Kannada, ಕನ್ನಡ, ಅಧ್ಯಾಯ 2, ಆತ್ಮ, ಸಾಂಖ್ಯ, ಕರ್ಮಯೋಗ, ಬುದ್ಧಿಯೋಗ, ಸ್ಥಿತಪ್ರಜ್ಞ, soul, duty, steady mind.","hyperLink":"https://vedabase.io/en/library/bg/2/","children":[{"id":"gita-ml-kn-ch2-s1","topic":"2.1–10 · ಅರ್ಜುನ ಶಿಷ್ಯನಾಗುತ್ತಾನೆ","note":"2.1–10 · ಅರ್ಜುನ ಶಿಷ್ಯನಾಗುತ್ತಾನೆ · BG 2.1–10","hyperLink":"https://vedabase.io/en/library/bg/2/","manas":{"links":[{"label":"📖 BG 2 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/"}]},"children":[{"id":"gita-ml-kn-ch2-v1","topic":"2.1 · ಅಳುತ್ತಿರುವ ಅರ್ಜುನನಿಗೆ ಕೃಷ್ಣ","note":"ಸಂಜಯ ಹೇಳುತ್ತಾನೆ: ಕರುಣೆ ಮತ್ತು ಕಣ್ಣೀರಿನಿಂದ ತುಂಬಿದ ಅರ್ಜುನನನ್ನು ನೋಡಿ ಕೃಷ್ಣ ಮಾತನಾಡಲು ಆರಂಭಿಸುತ್ತಾನೆ.","hyperLink":"https://vedabase.io/en/library/bg/2/1/","manas":{"links":[{"label":"📖 BG 2.1 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/1/"}]}},{"id":"gita-ml-kn-ch2-v2","topic":"2.2 · ಈ ದೌರ್ಬಲ್ಯ ತಕ್ಕದಲ್ಲ","note":"ಕೃಷ್ಣ: ಈ ದುರ್ಬಲತೆ ಶ್ರೇಷ್ಠನಿಗೆ ತಕ್ಕದಲ್ಲ; ಇದು ಸ್ವರ್ಗವಲ್ಲ, ಅಪಕೀರ್ತಿ ತರುತ್ತದೆ.","hyperLink":"https://vedabase.io/en/library/bg/2/2/","manas":{"links":[{"label":"📖 BG 2.2 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/2/"}]}},{"id":"gita-ml-kn-ch2-v3","topic":"2.3 · ಎದ್ದೇಳು, ಹೇಡಿತನ ಬಿಡು","note":"ಹೃದಯದ ಈ ಸಣ್ಣ ದೌರ್ಬಲ್ಯವನ್ನು ಬಿಟ್ಟು ಯುದ್ಧಕ್ಕೆ ಎದ್ದು ನಿಲ್ಲು.","hyperLink":"https://vedabase.io/en/library/bg/2/3/","manas":{"links":[{"label":"📖 BG 2.3 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/3/"}]}},{"id":"gita-ml-kn-ch2-v4","topic":"2.4 · ಪೂಜ್ಯರ ಮೇಲೆ ಬಾಣ ಹೇಗೆ?","note":"ಅರ್ಜುನ: ನಾನು ಗೌರವಿಸಬೇಕಾದ ಭೀಷ್ಮ, ದ್ರೋಣರ ಮೇಲೆ ಹೇಗೆ ಬಾಣ ಬಿಡಲಿ?","hyperLink":"https://vedabase.io/en/library/bg/2/4/","manas":{"links":[{"label":"📖 BG 2.4 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/4/"}]}},{"id":"gita-ml-kn-ch2-v5","topic":"2.5 · ಭಿಕ್ಷೆ ಬೇಡುವುದೇ ಲೇಸು","note":"ಗುರುಗಳ ರಕ್ತದಿಂದ ಕಲೆಯಾದ ಭೋಗಕ್ಕಿಂತ ಭಿಕ್ಷೆ ಬೇಡಿ ಬದುಕುವುದು ಲೇಸು.","hyperLink":"https://vedabase.io/en/library/bg/2/5/","manas":{"links":[{"label":"📖 BG 2.5 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/5/"}]}},{"id":"gita-ml-kn-ch2-v6","topic":"2.6 · ಗೆಲ್ಲುವುದೋ ಸೋಲುವುದೋ?","note":"ಗೆಲುವು ಒಳ್ಳೆಯದೋ ಸೋಲು ಒಳ್ಳೆಯದೋ ಅರ್ಜುನನಿಗೆ ತಿಳಿಯದು; ಧೃತರಾಷ್ಟ್ರನ ಮಕ್ಕಳನ್ನು ಕೊಂದು ಬದುಕಲು ಅವನಿಗೆ ಇಷ್ಟವಿಲ್ಲ.","hyperLink":"https://vedabase.io/en/library/bg/2/6/","manas":{"links":[{"label":"📖 BG 2.6 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/6/"}]}},{"id":"gita-ml-kn-ch2-v7","topic":"2.7 · ನಾನು ನಿನ್ನ ಶಿಷ್ಯ","note":"ಕರ್ತವ್ಯದ ಬಗ್ಗೆ ಗೊಂದಲಗೊಂಡ ಅರ್ಜುನ ಕೃಷ್ಣನಿಗೆ ಶರಣಾಗಿ ಶಿಷ್ಯನಾಗಿ ಖಚಿತವಾದ ಉಪದೇಶ ಕೇಳುತ್ತಾನೆ.","hyperLink":"https://vedabase.io/en/library/bg/2/7/","manas":{"links":[{"label":"📖 BG 2.7 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/7/"}],"q":"ಅರ್ಜುನ ಯಾವ ಭಾವದಿಂದ ಕೃಷ್ಣನಲ್ಲಿ ಉಪದೇಶ ಕೇಳಿದನು?"}},{"id":"gita-ml-kn-ch2-v8","topic":"2.8 · ಯಾವ ರಾಜ್ಯವೂ ದುಃಖ ನೀಗದು","note":"ದೇವತೆಗಳಂತಹ ರಾಜ್ಯ ಸಿಕ್ಕರೂ ಅವನ ಈ ದುಃಖ ದೂರವಾಗದು.","hyperLink":"https://vedabase.io/en/library/bg/2/8/","manas":{"links":[{"label":"📖 BG 2.8 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/8/"}]}},{"id":"gita-ml-kn-ch2-v9","topic":"2.9 · ನಾನು ಯುದ್ಧ ಮಾಡುವುದಿಲ್ಲ","note":"'ಗೋವಿಂದ, ನಾನು ಯುದ್ಧ ಮಾಡುವುದಿಲ್ಲ' ಎಂದು ಅರ್ಜುನ ಮೌನವಾಗುತ್ತಾನೆ.","hyperLink":"https://vedabase.io/en/library/bg/2/9/","manas":{"links":[{"label":"📖 BG 2.9 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/9/"}]}},{"id":"gita-ml-kn-ch2-v10","topic":"2.10 · ಕೃಷ್ಣ ನಗುತ್ತಾನೆ","note":"ಎರಡು ಸೈನ್ಯಗಳ ನಡುವೆ ಕೃಷ್ಣ ಮುಗುಳ್ನಗುತ್ತಾ ದುಃಖಿತ ಅರ್ಜುನನೊಂದಿಗೆ ಮಾತನಾಡುತ್ತಾನೆ.","hyperLink":"https://vedabase.io/en/library/bg/2/10/","manas":{"links":[{"label":"📖 BG 2.10 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/10/"}]}}]},{"id":"gita-ml-kn-ch2-s2","topic":"2.11–30 · ಆತ್ಮ ಎಂದಿಗೂ ಸಾಯುವುದಿಲ್ಲ","note":"2.11–30 · ಆತ್ಮ ಎಂದಿಗೂ ಸಾಯುವುದಿಲ್ಲ · BG 2.11–30","hyperLink":"https://vedabase.io/en/library/bg/2/","manas":{"links":[{"label":"📖 BG 2 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/"}]},"children":[{"id":"gita-ml-kn-ch2-v11","topic":"2.11 · ಜ್ಞಾನಿಗಳು ದುಃಖಿಸುವುದಿಲ್ಲ","note":"ಪಂಡಿತನಂತೆ ಮಾತನಾಡುತ್ತೀಯ, ಆದರೆ ವ್ಯರ್ಥವಾಗಿ ದುಃಖಿಸುತ್ತೀಯ; ಜ್ಞಾನಿಗಳು ಬದುಕಿರುವವರಿಗಾಗಲೀ ಸತ್ತವರಿಗಾಗಲೀ ದುಃಖಿಸುವುದಿಲ್ಲ.","hyperLink":"https://vedabase.io/en/library/bg/2/11/","manas":{"links":[{"label":"📖 BG 2.11 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/11/"}]}},{"id":"gita-ml-kn-ch2-v12","topic":"2.12 · ನಾವು ಸದಾ ಇದ್ದೆವು","note":"ಕೃಷ್ಣ, ಅರ್ಜುನ ಅಥವಾ ಈ ರಾಜರು ಇರದ ಕಾಲ ಎಂದೂ ಇರಲಿಲ್ಲ, ಮುಂದೆಯೂ ಇರುವುದಿಲ್ಲ.","hyperLink":"https://vedabase.io/en/library/bg/2/12/","manas":{"links":[{"label":"📖 BG 2.12 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/12/"}]}},{"id":"gita-ml-kn-ch2-v13","topic":"2.13 · ದೇಹ ಬದಲಾಗುತ್ತದೆ, ಆತ್ಮ ಮುಂದುವರಿಯುತ್ತದೆ","note":"ಆತ್ಮ ಬಾಲ್ಯ, ಯೌವನ, ಮುಪ್ಪು ದಾಟುವಂತೆ, ಮರಣದಲ್ಲಿ ಇನ್ನೊಂದು ದೇಹಕ್ಕೆ ಹೋಗುತ್ತದೆ.","hyperLink":"https://vedabase.io/en/library/bg/2/13/","manas":{"links":[{"label":"📖 BG 2.13 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/13/"}],"q":"ಮರಣದ ಸಮಯದಲ್ಲಿ ಆತ್ಮಕ್ಕೆ ಏನಾಗುತ್ತದೆ?"}},{"id":"gita-ml-kn-ch2-v14","topic":"2.14 · ಋತುಗಳಂತೆ ಸಹಿಸು","note":"ಸುಖ-ದುಃಖ ಚಳಿ-ಬಿಸಿಲಿನಂತೆ ಬಂದು ಹೋಗುತ್ತವೆ; ಅವನ್ನು ತಾಳ್ಮೆಯಿಂದ ಸಹಿಸಲು ಕಲಿ.","hyperLink":"https://vedabase.io/en/library/bg/2/14/","manas":{"links":[{"label":"📖 BG 2.14 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/14/"}]}},{"id":"gita-ml-kn-ch2-v15","topic":"2.15 · ಸಮಭಾವದಿಂದ ಮುಕ್ತಿ","note":"ಸುಖ-ದುಃಖಗಳಲ್ಲಿ ಅಲುಗಾಡದವನೇ ಮುಕ್ತಿಗೆ ಅರ್ಹ.","hyperLink":"https://vedabase.io/en/library/bg/2/15/","manas":{"links":[{"label":"📖 BG 2.15 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/15/"}]}},{"id":"gita-ml-kn-ch2-v16","topic":"2.16 · ಸತ್ ಮತ್ತು ಅಸತ್","note":"ತತ್ತ್ವದರ್ಶಿಗಳ ತೀರ್ಮಾನ: ದೇಹ ಉಳಿಯುವುದಿಲ್ಲ, ಆತ್ಮ ಬದಲಾಗುವುದಿಲ್ಲ.","hyperLink":"https://vedabase.io/en/library/bg/2/16/","manas":{"links":[{"label":"📖 BG 2.16 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/16/"}]}},{"id":"gita-ml-kn-ch2-v17","topic":"2.17 · ದೇಹವನ್ನೆಲ್ಲ ವ್ಯಾಪಿಸಿದೆ","note":"ದೇಹವನ್ನೆಲ್ಲ ಚೈತನ್ಯದಿಂದ ವ್ಯಾಪಿಸಿರುವ ಆತ್ಮವನ್ನು ಯಾರೂ ನಾಶಮಾಡಲಾರರು.","hyperLink":"https://vedabase.io/en/library/bg/2/17/","manas":{"links":[{"label":"📖 BG 2.17 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/17/"}]}},{"id":"gita-ml-kn-ch2-v18","topic":"2.18 · ಆದ್ದರಿಂದ ಯುದ್ಧ ಮಾಡು","note":"ನಿತ್ಯ ಆತ್ಮದ ದೇಹ ಖಂಡಿತ ನಾಶವಾಗುತ್ತದೆ; ಆದ್ದರಿಂದ ಯುದ್ಧ ಮಾಡು.","hyperLink":"https://vedabase.io/en/library/bg/2/18/","manas":{"links":[{"label":"📖 BG 2.18 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/18/"}]}},{"id":"gita-ml-kn-ch2-v19","topic":"2.19 · ಕೊಲ್ಲದು, ಸಾಯದು","note":"ಆತ್ಮವನ್ನು ಕೊಲ್ಲುವವನೆಂದು ಅಥವಾ ಕೊಲ್ಲಲ್ಪಡುವವನೆಂದು ಭಾವಿಸುವ ಇಬ್ಬರೂ ಅರಿಯರು; ಆತ್ಮ ಕೊಲ್ಲದು, ಸಾಯದು.","hyperLink":"https://vedabase.io/en/library/bg/2/19/","manas":{"links":[{"label":"📖 BG 2.19 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/19/"}]}},{"id":"gita-ml-kn-ch2-v20","topic":"2.20 · ಹುಟ್ಟಿಲ್ಲ, ಸಾವಿಲ್ಲ","note":"ಆತ್ಮ ಹುಟ್ಟಿಲ್ಲದ್ದು, ನಿತ್ಯ, ಸನಾತನ; ದೇಹ ಸತ್ತರೂ ಅದು ಸಾಯುವುದಿಲ್ಲ.","hyperLink":"https://vedabase.io/en/library/bg/2/20/","manas":{"links":[{"label":"📖 BG 2.20 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/20/"}],"q":"ದೇಹ ಸತ್ತಾಗ ಆತ್ಮ ಸಾಯುತ್ತದೆಯೇ?"}},{"id":"gita-ml-kn-ch2-v21","topic":"2.21 · ಯಾರು ಯಾರನ್ನು ಕೊಲ್ಲುತ್ತಾರೆ?","note":"ಆತ್ಮ ಅವಿನಾಶಿ, ಹುಟ್ಟಿಲ್ಲದ್ದು ಎಂದು ತಿಳಿದವನು ಯಾರನ್ನಾದರೂ ಹೇಗೆ ಕೊಲ್ಲುತ್ತಾನೆ ಅಥವಾ ಕೊಲ್ಲಿಸುತ್ತಾನೆ?","hyperLink":"https://vedabase.io/en/library/bg/2/21/","manas":{"links":[{"label":"📖 BG 2.21 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/21/"}]}},{"id":"gita-ml-kn-ch2-v22","topic":"2.22 · ಹಳೆ ಬಟ್ಟೆ, ಹೊಸ ಬಟ್ಟೆ","note":"ಮನುಷ್ಯ ಹಳೆಯ ಬಟ್ಟೆ ಬಿಟ್ಟು ಹೊಸದನ್ನು ಧರಿಸುವಂತೆ ಆತ್ಮ ಹೊಸ ದೇಹಗಳನ್ನು ಪಡೆಯುತ್ತದೆ.","hyperLink":"https://vedabase.io/en/library/bg/2/22/","manas":{"links":[{"label":"📖 BG 2.22 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/22/"}],"q":"ಆತ್ಮ ದೇಹ ಬದಲಿಸುವುದನ್ನು ಯಾವುದಕ್ಕೆ ಹೋಲಿಸಲಾಗಿದೆ?"}},{"id":"gita-ml-kn-ch2-v23","topic":"2.23 · ಆಯುಧ ಕತ್ತರಿಸದು","note":"ಆಯುಧ ಆತ್ಮವನ್ನು ಕತ್ತರಿಸದು, ಬೆಂಕಿ ಸುಡದು, ನೀರು ನೆನೆಸದು, ಗಾಳಿ ಒಣಗಿಸದು.","hyperLink":"https://vedabase.io/en/library/bg/2/23/","manas":{"links":[{"label":"📖 BG 2.23 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/23/"}]}},{"id":"gita-ml-kn-ch2-v24","topic":"2.24 · ಒಡೆಯದು, ಬದಲಾಗದು","note":"ಆತ್ಮ ಒಡೆಯದು, ನಿತ್ಯ, ಎಲ್ಲೆಡೆ ಇರುವುದು, ಅಚಲ ಮತ್ತು ಸದಾ ಒಂದೇ.","hyperLink":"https://vedabase.io/en/library/bg/2/24/","manas":{"links":[{"label":"📖 BG 2.24 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/24/"}]}},{"id":"gita-ml-kn-ch2-v25","topic":"2.25 · ಇಂದ್ರಿಯಗಳಿಗೆ ಅತೀತ","note":"ಆತ್ಮ ಕಾಣದು, ಊಹೆಗೆ ನಿಲುಕದು; ಇದನ್ನು ತಿಳಿದು ದೇಹಕ್ಕಾಗಿ ದುಃಖಿಸಬೇಡ.","hyperLink":"https://vedabase.io/en/library/bg/2/25/","manas":{"links":[{"label":"📖 BG 2.25 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/25/"}]}},{"id":"gita-ml-kn-ch2-v26","topic":"2.26 · ಆದರೂ ದುಃಖಕ್ಕೆ ಕಾರಣವಿಲ್ಲ","note":"ಆತ್ಮ ಮತ್ತೆ ಮತ್ತೆ ಹುಟ್ಟಿ ಸಾಯುತ್ತದೆ ಎಂದು ಭಾವಿಸಿದರೂ ದುಃಖಕ್ಕೆ ಕಾರಣವಿಲ್ಲ.","hyperLink":"https://vedabase.io/en/library/bg/2/26/","manas":{"links":[{"label":"📖 BG 2.26 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/26/"}]}},{"id":"gita-ml-kn-ch2-v27","topic":"2.27 · ಹುಟ್ಟಿದವನಿಗೆ ಸಾವು ಖಚಿತ","note":"ಹುಟ್ಟಿದವನಿಗೆ ಸಾವು, ಸತ್ತವನಿಗೆ ಹುಟ್ಟು ಖಚಿತ; ಆದ್ದರಿಂದ ಕರ್ತವ್ಯದಲ್ಲಿ ದುಃಖಿಸಬೇಡ.","hyperLink":"https://vedabase.io/en/library/bg/2/27/","manas":{"links":[{"label":"📖 BG 2.27 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/27/"}]}},{"id":"gita-ml-kn-ch2-v28","topic":"2.28 · ಅವ್ಯಕ್ತ-ವ್ಯಕ್ತ-ಅವ್ಯಕ್ತ","note":"ಜೀವಿಗಳು ಆರಂಭದಲ್ಲಿ ಕಾಣರು, ಮಧ್ಯದಲ್ಲಿ ಕಾಣುತ್ತಾರೆ, ಕೊನೆಯಲ್ಲಿ ಮತ್ತೆ ಕಾಣರು; ಹಾಗಿರುವಾಗ ದುಃಖವೇಕೆ?","hyperLink":"https://vedabase.io/en/library/bg/2/28/","manas":{"links":[{"label":"📖 BG 2.28 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/28/"}]}},{"id":"gita-ml-kn-ch2-v29","topic":"2.29 · ಅದ್ಭುತ ಆತ್ಮ","note":"ಕೆಲವರು ಆತ್ಮವನ್ನು ಅದ್ಭುತವಾಗಿ ನೋಡುತ್ತಾರೆ, ಕೆಲವರು ವರ್ಣಿಸುತ್ತಾರೆ, ಕೆಲವರು ಕೇಳುತ್ತಾರೆ; ಹಲವರು ಕೇಳಿಯೂ ಅರಿಯರು.","hyperLink":"https://vedabase.io/en/library/bg/2/29/","manas":{"links":[{"label":"📖 BG 2.29 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/29/"}]}},{"id":"gita-ml-kn-ch2-v30","topic":"2.30 · ದೇಹಿ ಅವಧ್ಯ","note":"ದೇಹದಲ್ಲಿ ವಾಸಿಸುವವನನ್ನು ಎಂದಿಗೂ ಕೊಲ್ಲಲಾಗದು; ಆದ್ದರಿಂದ ಯಾವ ಜೀವಿಗಾಗಿಯೂ ದುಃಖಿಸಬೇಡ.","hyperLink":"https://vedabase.io/en/library/bg/2/30/","manas":{"links":[{"label":"📖 BG 2.30 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/30/"}]}}]},{"id":"gita-ml-kn-ch2-s3","topic":"2.31–38 · ಕ್ಷತ್ರಿಯನ ಕರ್ತವ್ಯ","note":"2.31–38 · ಕ್ಷತ್ರಿಯನ ಕರ್ತವ್ಯ · BG 2.31–38","hyperLink":"https://vedabase.io/en/library/bg/2/","manas":{"links":[{"label":"📖 BG 2 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/"}]},"children":[{"id":"gita-ml-kn-ch2-v31","topic":"2.31 · ಕ್ಷತ್ರಿಯ ಧರ್ಮ","note":"ಕ್ಷತ್ರಿಯನಿಗೆ ಧರ್ಮಕ್ಕಾಗಿ ಹೋರಾಡುವುದಕ್ಕಿಂತ ಮಿಗಿಲಾದ ಕರ್ತವ್ಯವಿಲ್ಲ; ಆದ್ದರಿಂದ ಹಿಂಜರಿಯಬೇಡ.","hyperLink":"https://vedabase.io/en/library/bg/2/31/","manas":{"links":[{"label":"📖 BG 2.31 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/31/"}]}},{"id":"gita-ml-kn-ch2-v32","topic":"2.32 · ಸ್ವರ್ಗದ ತೆರೆದ ಬಾಗಿಲು","note":"ಅದೃಷ್ಟವಂತ ಕ್ಷತ್ರಿಯರಿಗೆ ಇಂತಹ ಯುದ್ಧ ಕೇಳದೆಯೇ ಸಿಗುತ್ತದೆ, ಅದು ಸ್ವರ್ಗದ ಬಾಗಿಲು ತೆರೆಯುತ್ತದೆ.","hyperLink":"https://vedabase.io/en/library/bg/2/32/","manas":{"links":[{"label":"📖 BG 2.32 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/32/"}]}},{"id":"gita-ml-kn-ch2-v33","topic":"2.33 · ಪಾಪ ಮತ್ತು ಅಪಕೀರ್ತಿ","note":"ಈ ಧರ್ಮಯುದ್ಧ ಮಾಡದಿದ್ದರೆ ಕರ್ತವ್ಯ ತ್ಯಜಿಸಿದ ಪಾಪ ಮತ್ತು ಕೀರ್ತಿನಷ್ಟ ಉಂಟಾಗುತ್ತದೆ.","hyperLink":"https://vedabase.io/en/library/bg/2/33/","manas":{"links":[{"label":"📖 BG 2.33 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/33/"}]}},{"id":"gita-ml-kn-ch2-v34","topic":"2.34 · ಅವಮಾನ ಸಾವಿಗಿಂತ ಕೆಟ್ಟದು","note":"ಜನರು ಸದಾ ನಿನ್ನನ್ನು ನಿಂದಿಸುತ್ತಾರೆ; ಗೌರವಾನ್ವಿತನಿಗೆ ಅವಮಾನ ಸಾವಿಗಿಂತ ಕೆಟ್ಟದು.","hyperLink":"https://vedabase.io/en/library/bg/2/34/","manas":{"links":[{"label":"📖 BG 2.34 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/34/"}]}},{"id":"gita-ml-kn-ch2-v35","topic":"2.35 · ಹೇಡಿಯೆಂದು ಭಾವಿಸುವರು","note":"ಮಹಾರಥರು ನೀನು ಭಯದಿಂದ ಓಡಿಹೋದೆ ಎಂದು ಭಾವಿಸಿ ನಿನ್ನನ್ನು ಕೀಳಾಗಿ ಕಾಣುತ್ತಾರೆ.","hyperLink":"https://vedabase.io/en/library/bg/2/35/","manas":{"links":[{"label":"📖 BG 2.35 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/35/"}]}},{"id":"gita-ml-kn-ch2-v36","topic":"2.36 · ಶತ್ರುಗಳ ಹಾಸ್ಯ","note":"ಶತ್ರುಗಳು ಕಟು ಮಾತುಗಳಿಂದ ನಿನ್ನ ಸಾಮರ್ಥ್ಯವನ್ನು ಹಾಸ್ಯ ಮಾಡುತ್ತಾರೆ; ಇದಕ್ಕಿಂತ ನೋವು ಏನಿದೆ?","hyperLink":"https://vedabase.io/en/library/bg/2/36/","manas":{"links":[{"label":"📖 BG 2.36 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/36/"}]}},{"id":"gita-ml-kn-ch2-v37","topic":"2.37 · ಎರಡೂ ರೀತಿ ಲಾಭ","note":"ಸತ್ತರೆ ಸ್ವರ್ಗ, ಗೆದ್ದರೆ ಭೂರಾಜ್ಯ; ಆದ್ದರಿಂದ ದೃಢನಿಶ್ಚಯದಿಂದ ಎದ್ದು ಹೋರಾಡು.","hyperLink":"https://vedabase.io/en/library/bg/2/37/","manas":{"links":[{"label":"📖 BG 2.37 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/37/"}]}},{"id":"gita-ml-kn-ch2-v38","topic":"2.38 · ಸಮಭಾವದಿಂದ ಹೋರಾಡು","note":"ಸುಖ-ದುಃಖ, ಲಾಭ-ನಷ್ಟ, ಜಯ-ಅಪಜಯ ಸಮವೆಂದು ತಿಳಿದು ಹೋರಾಡು; ಆಗ ಪಾಪ ತಟ್ಟದು.","hyperLink":"https://vedabase.io/en/library/bg/2/38/","manas":{"links":[{"label":"📖 BG 2.38 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/38/"}]}}]},{"id":"gita-ml-kn-ch2-s4","topic":"2.39–53 · ಫಲಾಸಕ್ತಿಯಿಲ್ಲದ ಕರ್ಮ (ಬುದ್ಧಿಯೋಗ)","note":"2.39–53 · ಫಲಾಸಕ್ತಿಯಿಲ್ಲದ ಕರ್ಮ (ಬುದ್ಧಿಯೋಗ) · BG 2.39–53","hyperLink":"https://vedabase.io/en/library/bg/2/","manas":{"links":[{"label":"📖 BG 2 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/"}]},"children":[{"id":"gita-ml-kn-ch2-v39","topic":"2.39 · ಈಗ ಬುದ್ಧಿಯೋಗ ಕೇಳು","note":"ಇಲ್ಲಿಯವರೆಗೆ ಸಾಂಖ್ಯದಿಂದ ವಿವರಿಸಿದೆ; ಈಗ ಫಲಾಪೇಕ್ಷೆಯಿಲ್ಲದ ಕರ್ಮಯೋಗ ಕೇಳು, ಅದು ಕರ್ಮಬಂಧನದಿಂದ ಬಿಡಿಸುತ್ತದೆ.","hyperLink":"https://vedabase.io/en/library/bg/2/39/","manas":{"links":[{"label":"📖 BG 2.39 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/39/"}]}},{"id":"gita-ml-kn-ch2-v40","topic":"2.40 · ಈ ದಾರಿಯಲ್ಲಿ ನಷ್ಟವಿಲ್ಲ","note":"ಇಲ್ಲಿ ಯಾವ ಪ್ರಯತ್ನವೂ ವ್ಯರ್ಥವಾಗದು; ಸ್ವಲ್ಪ ಪ್ರಗತಿಯೂ ದೊಡ್ಡ ಭಯದಿಂದ ಕಾಪಾಡುತ್ತದೆ.","hyperLink":"https://vedabase.io/en/library/bg/2/40/","manas":{"links":[{"label":"📖 BG 2.40 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/40/"}]}},{"id":"gita-ml-kn-ch2-v41","topic":"2.41 · ಒಂದೇ ಗುರಿ","note":"ದೃಢಚಿತ್ತರಿಗೆ ಗುರಿ ಒಂದೇ; ಅಸ್ಥಿರನ ಬುದ್ಧಿ ಹಲವು ಕವಲುಗಳಾಗಿ ಹರಡುತ್ತದೆ.","hyperLink":"https://vedabase.io/en/library/bg/2/41/","manas":{"links":[{"label":"📖 BG 2.41 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/41/"}]}},{"id":"gita-ml-kn-ch2-v42-43","topic":"2.42-43 · ಆಕರ್ಷಕ ಮಾತುಗಳು","note":"ಅಲ್ಪಜ್ಞರು ಸ್ವರ್ಗ, ಉತ್ತಮ ಜನ್ಮ, ಅಧಿಕಾರ ಕೊಡುತ್ತವೆನ್ನುವ ವೇದದ ಆಕರ್ಷಕ ಮಾತುಗಳಿಗೆ ಅಂಟಿಕೊಂಡು, ಇದಕ್ಕಿಂತ ಮಿಗಿಲು ಏನೂ ಇಲ್ಲ ಎನ್ನುತ್ತಾರೆ.","hyperLink":"https://vedabase.io/en/library/bg/2/42-43/","manas":{"links":[{"label":"📖 BG 2.42-43 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/42-43/"}]}},{"id":"gita-ml-kn-ch2-v44","topic":"2.44 · ಭೋಗಾಸಕ್ತಿಯಲ್ಲಿ ದೃಢತೆ ಇಲ್ಲ","note":"ಭೋಗ ಮತ್ತು ಐಶ್ವರ್ಯದಲ್ಲಿ ಸಿಲುಕಿದವರ ಮನಸ್ಸಿನಲ್ಲಿ ಭಗವಂತನ ಭಕ್ತಿಗೆ ದೃಢನಿಶ್ಚಯ ಮೂಡುವುದಿಲ್ಲ.","hyperLink":"https://vedabase.io/en/library/bg/2/44/","manas":{"links":[{"label":"📖 BG 2.44 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/44/"}]}},{"id":"gita-ml-kn-ch2-v45","topic":"2.45 · ತ್ರಿಗುಣಗಳನ್ನು ಮೀರು","note":"ವೇದಗಳು ಮುಖ್ಯವಾಗಿ ಮೂರು ಗುಣಗಳ ಬಗ್ಗೆ ಹೇಳುತ್ತವೆ; ಅವನ್ನು ಮೀರಿ, ದ್ವಂದ್ವ ಮತ್ತು ಚಿಂತೆ ಬಿಟ್ಟು, ಆತ್ಮದಲ್ಲಿ ನೆಲೆಸು.","hyperLink":"https://vedabase.io/en/library/bg/2/45/","manas":{"links":[{"label":"📖 BG 2.45 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/45/"}]}},{"id":"gita-ml-kn-ch2-v46","topic":"2.46 · ಬಾವಿ ಮತ್ತು ಸರೋವರ","note":"ಸಣ್ಣ ಬಾವಿಯ ಕೆಲಸ ದೊಡ್ಡ ಜಲಾಶಯದಿಂದಲೇ ಆಗುತ್ತದೆ; ವೇದದ ಉದ್ದೇಶ ತಿಳಿದವನಿಗೆ ಎಲ್ಲವೂ ಸಿಗುತ್ತದೆ.","hyperLink":"https://vedabase.io/en/library/bg/2/46/","manas":{"links":[{"label":"📖 BG 2.46 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/46/"}]}},{"id":"gita-ml-kn-ch2-v47","topic":"2.47 · ಕರ್ಮ ನಿನ್ನದು, ಫಲವಲ್ಲ","note":"ಕರ್ಮ ಮಾಡುವುದರಲ್ಲಿ ಮಾತ್ರ ನಿನಗೆ ಅಧಿಕಾರ, ಫಲದಲ್ಲಿ ಅಲ್ಲ; ನಿನ್ನನ್ನು ಫಲಕ್ಕೆ ಕಾರಣನೆಂದು ತಿಳಿಯಬೇಡ, ಕರ್ಮ ಬಿಡುವುದರಲ್ಲೂ ಆಸಕ್ತಿ ಬೇಡ.","hyperLink":"https://vedabase.io/en/library/bg/2/47/","manas":{"links":[{"label":"📖 BG 2.47 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/47/"}],"q":"ಕರ್ಮ ಮತ್ತು ಫಲದ ಬಗ್ಗೆ ಕೃಷ್ಣ ಏನು ಹೇಳುತ್ತಾನೆ?"}},{"id":"gita-ml-kn-ch2-v48","topic":"2.48 · ಸಮತ್ವವೇ ಯೋಗ","note":"ಜಯ-ಅಪಜಯಗಳ ಮೇಲಿನ ಆಸಕ್ತಿ ಬಿಟ್ಟು ಸಮಭಾವದಿಂದ ಕರ್ಮ ಮಾಡು; ಆ ಸಮತ್ವವೇ ಯೋಗ.","hyperLink":"https://vedabase.io/en/library/bg/2/48/","manas":{"links":[{"label":"📖 BG 2.48 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/48/"}]}},{"id":"gita-ml-kn-ch2-v49","topic":"2.49 · ಫಲಕ್ಕಾಗಿ ಮಾತ್ರ ದುಡಿಯುವುದು ಜಿಪುಣತನ","note":"ಭಕ್ತಿಯಿಂದ ಕೀಳು ಕರ್ಮಗಳನ್ನು ದೂರವಿಟ್ಟು ಭಗವಂತನಿಗೆ ಶರಣಾಗು; ಫಲ ಮಾತ್ರ ಬಯಸುವವರು ಜಿಪುಣರು.","hyperLink":"https://vedabase.io/en/library/bg/2/49/","manas":{"links":[{"label":"📖 BG 2.49 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/49/"}]}},{"id":"gita-ml-kn-ch2-v50","topic":"2.50 · ಯೋಗ: ಕರ್ಮದ ಕೌಶಲ","note":"ಭಕ್ತಿಯಲ್ಲಿ ತೊಡಗಿದವನು ಈ ಜನ್ಮದಲ್ಲೇ ಒಳ್ಳೆಯ-ಕೆಟ್ಟ ಎರಡೂ ಫಲಗಳಿಂದ ಮುಕ್ತನಾಗುತ್ತಾನೆ; ಯೋಗ ಕರ್ಮದ ಕಲೆ.","hyperLink":"https://vedabase.io/en/library/bg/2/50/","manas":{"links":[{"label":"📖 BG 2.50 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/50/"}]}},{"id":"gita-ml-kn-ch2-v51","topic":"2.51 · ಹುಟ್ಟು ಸಾವಿನ ಆಚೆ","note":"ಹೀಗೆ ಕರ್ಮ ಮಾಡುವ ಋಷಿಗಳು ಕರ್ಮಫಲದಿಂದ ಬಿಡುಗಡೆಯಾಗಿ ಹುಟ್ಟು-ಸಾವಿನ ಚಕ್ರದಿಂದ ಮುಕ್ತರಾಗಿ ದುಃಖವಿಲ್ಲದ ಸ್ಥಿತಿ ತಲುಪುತ್ತಾರೆ.","hyperLink":"https://vedabase.io/en/library/bg/2/51/","manas":{"links":[{"label":"📖 BG 2.51 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/51/"}]}},{"id":"gita-ml-kn-ch2-v52","topic":"2.52 · ಮೋಹದ ಕಾಡಿನಿಂದ ಹೊರಗೆ","note":"ಬುದ್ಧಿ ಮೋಹವೆಂಬ ದಟ್ಟ ಕಾಡನ್ನು ದಾಟಿದಾಗ, ಕೇಳಿದ್ದು ಕೇಳಬೇಕಾದ್ದು ನಿನಗೆ ಲೆಕ್ಕಕ್ಕಿಲ್ಲ.","hyperLink":"https://vedabase.io/en/library/bg/2/52/","manas":{"links":[{"label":"📖 BG 2.52 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/52/"}]}},{"id":"gita-ml-kn-ch2-v53","topic":"2.53 · ಸಮಾಧಿಯಲ್ಲಿ ಸ್ಥಿರ","note":"ಮನಸ್ಸು ವೇದದ ಆಕರ್ಷಕ ಮಾತುಗಳಿಂದ ಅಲುಗಾಡದೆ ಆತ್ಮಸಾಕ್ಷಾತ್ಕಾರದಲ್ಲಿ ನಿಂತಾಗ ನೀನು ಯೋಗ ಪಡೆಯುವೆ.","hyperLink":"https://vedabase.io/en/library/bg/2/53/","manas":{"links":[{"label":"📖 BG 2.53 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/53/"}]}}]},{"id":"gita-ml-kn-ch2-s5","topic":"2.54–72 · ಸ್ಥಿರ ಬುದ್ಧಿಯುಳ್ಳವನು","note":"2.54–72 · ಸ್ಥಿರ ಬುದ್ಧಿಯುಳ್ಳವನು · BG 2.54–72","hyperLink":"https://vedabase.io/en/library/bg/2/","manas":{"links":[{"label":"📖 BG 2 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/"}]},"children":[{"id":"gita-ml-kn-ch2-v54","topic":"2.54 · ಅರ್ಜುನನ ಪ್ರಶ್ನೆ","note":"ಅರ್ಜುನ ಕೇಳುತ್ತಾನೆ: ಸ್ಥಿರಬುದ್ಧಿಯುಳ್ಳವನು ಹೇಗೆ ಮಾತನಾಡುತ್ತಾನೆ, ಕುಳಿತುಕೊಳ್ಳುತ್ತಾನೆ, ನಡೆಯುತ್ತಾನೆ?","hyperLink":"https://vedabase.io/en/library/bg/2/54/","manas":{"links":[{"label":"📖 BG 2.54 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/54/"}]}},{"id":"gita-ml-kn-ch2-v55","topic":"2.55 · ಆತ್ಮದಲ್ಲಿ ತೃಪ್ತಿ","note":"ಮನಸ್ಸಿನಿಂದ ಹುಟ್ಟುವ ಎಲ್ಲ ಭೋಗಾಸೆಗಳನ್ನು ಬಿಟ್ಟು ಆತ್ಮದಲ್ಲೇ ತೃಪ್ತನಾದವನು ಸ್ಥಿತಪ್ರಜ್ಞ.","hyperLink":"https://vedabase.io/en/library/bg/2/55/","manas":{"links":[{"label":"📖 BG 2.55 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/55/"}]}},{"id":"gita-ml-kn-ch2-v56","topic":"2.56 · ಸ್ಥಿರ ಮುನಿ","note":"ದುಃಖದಲ್ಲಿ ಕಂಗೆಡದ, ಸುಖದಲ್ಲಿ ಉಬ್ಬದ, ಆಸಕ್ತಿ, ಭಯ, ಕೋಪವಿಲ್ಲದವನು ಸ್ಥಿರ ಮುನಿ.","hyperLink":"https://vedabase.io/en/library/bg/2/56/","manas":{"links":[{"label":"📖 BG 2.56 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/56/"}]}},{"id":"gita-ml-kn-ch2-v57","topic":"2.57 · ಹೊಗಳಿಕೆಯೂ ಇಲ್ಲ, ದ್ವೇಷವೂ ಇಲ್ಲ","note":"ಒಳ್ಳೆಯದು ಕೆಟ್ಟದು ಏನೇ ಬಂದರೂ ಹಿಗ್ಗದೆ ದ್ವೇಷಿಸದೆ ಇರುವವನ ಜ್ಞಾನ ದೃಢ.","hyperLink":"https://vedabase.io/en/library/bg/2/57/","manas":{"links":[{"label":"📖 BG 2.57 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/57/"}]}},{"id":"gita-ml-kn-ch2-v58","topic":"2.58 · ಆಮೆಯಂತೆ","note":"ಆಮೆ ತನ್ನ ಅಂಗಗಳನ್ನು ಒಳಗೆ ಎಳೆದುಕೊಳ್ಳುವಂತೆ ಇಂದ್ರಿಯಗಳನ್ನು ವಿಷಯಗಳಿಂದ ಹಿಂತೆಗೆಯುವವನು ಸ್ಥಿರ.","hyperLink":"https://vedabase.io/en/library/bg/2/58/","manas":{"links":[{"label":"📖 BG 2.58 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/58/"}]}},{"id":"gita-ml-kn-ch2-v59","topic":"2.59 · ಉನ್ನತ ರುಚಿ","note":"ವಿಷಯಗಳಿಂದ ದೂರವಿದ್ದರೂ ರುಚಿ ಉಳಿಯುತ್ತದೆ; ಉನ್ನತ ರುಚಿ ಸಿಕ್ಕಾಗ ಅದೂ ಹೋಗುತ್ತದೆ.","hyperLink":"https://vedabase.io/en/library/bg/2/59/","manas":{"links":[{"label":"📖 BG 2.59 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/59/"}]}},{"id":"gita-ml-kn-ch2-v60","topic":"2.60 · ಇಂದ್ರಿಯಗಳು ಮನಸ್ಸನ್ನು ಎಳೆಯುತ್ತವೆ","note":"ಪ್ರಯತ್ನಿಸುತ್ತಿರುವ ವಿವೇಕಿಯ ಮನಸ್ಸನ್ನೂ ಬಲವಂತವಾಗಿ ಎಳೆಯುವಷ್ಟು ಇಂದ್ರಿಯಗಳು ಪ್ರಬಲ.","hyperLink":"https://vedabase.io/en/library/bg/2/60/","manas":{"links":[{"label":"📖 BG 2.60 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/60/"}]}},{"id":"gita-ml-kn-ch2-v61","topic":"2.61 · ಮನಸ್ಸನ್ನು ನನ್ನಲ್ಲಿ ಇಡು","note":"ಇಂದ್ರಿಯಗಳನ್ನು ಹಿಡಿತದಲ್ಲಿಟ್ಟು ಕೃಷ್ಣನಲ್ಲಿ ಮನಸ್ಸಿಡುವವನ ಬುದ್ಧಿ ಸ್ಥಿರ.","hyperLink":"https://vedabase.io/en/library/bg/2/61/","manas":{"links":[{"label":"📖 BG 2.61 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/61/"}]}},{"id":"gita-ml-kn-ch2-v62","topic":"2.62 · ಪತನದ ಮೆಟ್ಟಿಲು (1)","note":"ವಿಷಯಗಳ ಚಿಂತನೆ ಆಸಕ್ತಿ ತರುತ್ತದೆ; ಆಸಕ್ತಿಯಿಂದ ಕಾಮ, ಕಾಮದಿಂದ ಕೋಪ ಹುಟ್ಟುತ್ತದೆ.","hyperLink":"https://vedabase.io/en/library/bg/2/62/","manas":{"links":[{"label":"📖 BG 2.62 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/62/"}],"q":"ವಿಷಯಗಳ ಚಿಂತನೆ ಯಾವ ಕ್ರಮದಲ್ಲಿ ಕೋಪಕ್ಕೆ ಕೊಂಡೊಯ್ಯುತ್ತದೆ?"}},{"id":"gita-ml-kn-ch2-v63","topic":"2.63 · ಪತನದ ಮೆಟ್ಟಿಲು (2)","note":"ಕೋಪದಿಂದ ಮೋಹ, ಮೋಹದಿಂದ ಸ್ಮೃತಿಭ್ರಮೆ, ಅದರಿಂದ ಬುದ್ಧಿನಾಶ, ನಂತರ ಪತನ.","hyperLink":"https://vedabase.io/en/library/bg/2/63/","manas":{"links":[{"label":"📖 BG 2.63 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/63/"}]}},{"id":"gita-ml-kn-ch2-v64","topic":"2.64 · ಭಗವಂತನ ಕೃಪೆ","note":"ರಾಗ-ದ್ವೇಷ ರಹಿತನಾಗಿ ನಿಯಮಗಳಿಂದ ಇಂದ್ರಿಯಗಳನ್ನು ಗೆದ್ದವನು ಭಗವಂತನ ಪೂರ್ಣ ಕೃಪೆ ಪಡೆಯುತ್ತಾನೆ.","hyperLink":"https://vedabase.io/en/library/bg/2/64/","manas":{"links":[{"label":"📖 BG 2.64 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/64/"}]}},{"id":"gita-ml-kn-ch2-v65","topic":"2.65 · ದುಃಖಗಳ ಅಂತ್ಯ","note":"ಅಂತಹ ಪ್ರಸನ್ನತೆಯಲ್ಲಿ ಲೋಕದ ದುಃಖಗಳು ಮಾಯವಾಗಿ ಬುದ್ಧಿ ಬೇಗ ಸ್ಥಿರವಾಗುತ್ತದೆ.","hyperLink":"https://vedabase.io/en/library/bg/2/65/","manas":{"links":[{"label":"📖 BG 2.65 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/65/"}]}},{"id":"gita-ml-kn-ch2-v66","topic":"2.66 · ಸಂಬಂಧವಿಲ್ಲದೆ ಶಾಂತಿಯಿಲ್ಲ","note":"ಪರಮಾತ್ಮನೊಂದಿಗೆ ಸಂಬಂಧವಿಲ್ಲದವನಿಗೆ ಸ್ಥಿರಬುದ್ಧಿಯೂ ಶಾಂತಿಯೂ ಇಲ್ಲ; ಶಾಂತಿಯಿಲ್ಲದೆ ಸುಖ ಎಲ್ಲಿ?","hyperLink":"https://vedabase.io/en/library/bg/2/66/","manas":{"links":[{"label":"📖 BG 2.66 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/66/"}]}},{"id":"gita-ml-kn-ch2-v67","topic":"2.67 · ಗಾಳಿ ಮತ್ತು ದೋಣಿ","note":"ಬಲವಾದ ಗಾಳಿ ದೋಣಿಯನ್ನು ಕೊಚ್ಚಿಕೊಂಡು ಹೋಗುವಂತೆ, ಅಲೆಯುವ ಒಂದು ಇಂದ್ರಿಯವೂ ಬುದ್ಧಿಯನ್ನು ಕೊಂಡೊಯ್ಯಬಹುದು.","hyperLink":"https://vedabase.io/en/library/bg/2/67/","manas":{"links":[{"label":"📖 BG 2.67 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/67/"}]}},{"id":"gita-ml-kn-ch2-v68","topic":"2.68 · ಸಂಯಮಿಯ ಸ್ಥಿರಬುದ್ಧಿ","note":"ಆದ್ದರಿಂದ ಇಂದ್ರಿಯಗಳನ್ನು ವಿಷಯಗಳಿಂದ ತಡೆದವನ ಬುದ್ಧಿ ಖಂಡಿತ ಸ್ಥಿರ.","hyperLink":"https://vedabase.io/en/library/bg/2/68/","manas":{"links":[{"label":"📖 BG 2.68 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/68/"}]}},{"id":"gita-ml-kn-ch2-v69","topic":"2.69 · ರಾತ್ರಿ ಮತ್ತು ಎಚ್ಚರ","note":"ಎಲ್ಲರಿಗೂ ರಾತ್ರಿಯಾದುದು ಸಂಯಮಿಗೆ ಎಚ್ಚರ; ಎಲ್ಲರೂ ಎಚ್ಚರವಿರುವುದು ಮುನಿಗೆ ರಾತ್ರಿ.","hyperLink":"https://vedabase.io/en/library/bg/2/69/","manas":{"links":[{"label":"📖 BG 2.69 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/69/"}]}},{"id":"gita-ml-kn-ch2-v70","topic":"2.70 · ಸಮುದ್ರ ಮತ್ತು ನದಿಗಳು","note":"ನದಿಗಳು ತುಂಬುತ್ತಿದ್ದರೂ ಸಮುದ್ರ ಶಾಂತವಾಗಿರುವಂತೆ, ಆಸೆಗಳ ನಡುವೆ ಅಚಲನಾದವನೇ ಶಾಂತಿ ಪಡೆಯುತ್ತಾನೆ.","hyperLink":"https://vedabase.io/en/library/bg/2/70/","manas":{"links":[{"label":"📖 BG 2.70 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/70/"}]}},{"id":"gita-ml-kn-ch2-v71","topic":"2.71 · 'ನನ್ನದು' ಬಿಡು","note":"ಎಲ್ಲ ಆಸೆ, ಮಮಕಾರ ಮತ್ತು ಮಿಥ್ಯಾಹಂಕಾರ ಬಿಟ್ಟವನೇ ನಿಜವಾದ ಶಾಂತಿ ಪಡೆಯುತ್ತಾನೆ.","hyperLink":"https://vedabase.io/en/library/bg/2/71/","manas":{"links":[{"label":"📖 BG 2.71 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/71/"}]}},{"id":"gita-ml-kn-ch2-v72","topic":"2.72 · ಬ್ರಾಹ್ಮೀ ಸ್ಥಿತಿ","note":"ಇದೇ ಆಧ್ಯಾತ್ಮಿಕ ಸ್ಥಿತಿ; ಇದರಲ್ಲಿ ಮೋಹವಿಲ್ಲ, ಮರಣ ಕಾಲದಲ್ಲೂ ಇದರಲ್ಲಿ ನೆಲೆಸಿದವನು ಭಗವಂತನ ರಾಜ್ಯ ಸೇರುತ್ತಾನೆ.","hyperLink":"https://vedabase.io/en/library/bg/2/72/","manas":{"links":[{"label":"📖 BG 2.72 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/72/"}]}}]},{"id":"gita-ml-kn-ch2-see","topic":"🔗 vedabase.io · ಕನ್ನಡ","note":"Bhagavad-gita Chapter 2 on vedabase.io (English). The same chapter in the other nine languages is on this library's shelf.","hyperLink":"https://vedabase.io/en/library/bg/2/","manas":{"links":[{"label":"📖 BG 2 · vedabase.io (English)","url":"https://vedabase.io/en/library/bg/2/"}]}}]}},"part":"kn","updated":1795357904858,"created":1795357904858}]}